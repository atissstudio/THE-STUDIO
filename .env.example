# Copia este archivo a .env (nunca lo commitees) y rellena con tus valores reales.

# Token de la integración interna de Notion (Notion → Configuración → Integraciones).
# Debe tener acceso compartido a la Base de datos de clientes.
NOTION_TOKEN=

# ID de la data source de la Base de datos de clientes en Notion.
# https://app.notion.com/p/8d580ef34c0443ddaf363a6e1c0fdce6
NOTION_CLIENTS_DB_ID=

# Supabase — panel interno (/admin) y portal de cliente (/portal).
# Project Settings → API. La anon key es pública (segura por RLS, ver supabase/schema.sql);
# NUNCA pongas aquí la service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
