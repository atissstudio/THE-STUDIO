---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdmin } from "../../../lib/requireAdmin";

export const prerender = false;

const { redirect, supabase } = await requireAdmin(Astro);
if (redirect) return redirect;

const preselectCliente = Astro.url.searchParams.get("cliente") ?? "";
let formError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const cliente_id = String(form.get("cliente_id") ?? "");
  const concepto = String(form.get("concepto") ?? "").trim();
  const importe = Number(form.get("importe"));
  const fecha_vencimiento = String(form.get("fecha_vencimiento") ?? "") || null;

  if (!cliente_id || !concepto || !importe) {
    formError = "Cliente, concepto e importe son obligatorios.";
  } else {
    const year = new Date().getFullYear();
    const { count } = await supabase!
      .from("facturas")
      .select("*", { count: "exact", head: true })
      .like("numero", `${year}-%`);
    const numero = `${year}-${String((count ?? 0) + 1).padStart(3, "0")}`;

    const { error } = await supabase!.from("facturas").insert({
      cliente_id,
      numero,
      concepto,
      importe,
      fecha_vencimiento,
    });
    if (error) formError = error.message;
    else return Astro.redirect("/admin/facturas");
  }
}

const { data: clientes } = await supabase!.from("clientes").select("id, nombre").order("nombre");
const { data: facturas } = await supabase!
  .from("facturas")
  .select("id, numero, concepto, importe, estado, fecha_emision, clientes(nombre)")
  .order("fecha_emision", { ascending: false });
---

<AdminLayout title="Facturas — panel interno" path="/admin/facturas">
  <h1>Facturas</h1>

  <p class="notice">
    Los datos fiscales del emisor (razón social, CIF) están pendientes de que se constituya la
    cooperativa — el PDF se generará con ese hueco marcado hasta entonces.
  </p>

  <details class="new-invoice" open={!!preselectCliente}>
    <summary>+ Nueva factura</summary>
    <form method="POST" class="invoice-form">
      <label>
        Cliente
        <select name="cliente_id" required>
          <option value="">Selecciona…</option>
          {clientes?.map((c) => (
            <option value={c.id} selected={c.id === preselectCliente}>{c.nombre}</option>
          ))}
        </select>
      </label>
      <label>Concepto <input type="text" name="concepto" required /></label>
      <label>Importe (€) <input type="number" step="0.01" min="0" name="importe" required /></label>
      <label>Vencimiento <input type="date" name="fecha_vencimiento" /></label>
      {formError && <p class="error">{formError}</p>}
      <button type="submit">Crear factura</button>
    </form>
  </details>

  {!facturas?.length ? (
    <p class="empty">Todavía no hay facturas.</p>
  ) : (
    <table>
      <thead>
        <tr><th>Número</th><th>Cliente</th><th>Concepto</th><th>Importe</th><th>Estado</th></tr>
      </thead>
      <tbody>
        {facturas.map((f: any) => (
          <tr>
            <td>{f.numero}</td>
            <td>{f.clientes?.nombre ?? "—"}</td>
            <td>{f.concepto}</td>
            <td>{Number(f.importe).toFixed(2)} €</td>
            <td><span class={`badge badge-${f.estado}`}>{f.estado}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  )}

  <style>
    h1 { font-size: 1.6rem; margin-bottom: 12px; }
    .notice { background: #fff8e1; border: 1px solid #f0dca0; padding: 10px 14px; font-size: 0.85rem; color: #6b5a1e; margin-bottom: 20px; }
    .new-invoice { margin-bottom: 28px; }
    .new-invoice summary { cursor: pointer; color: #334ba4; font-weight: bold; margin-bottom: 12px; }
    .invoice-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      background: #fff;
      border: 1px solid #dde1e8;
      padding: 20px;
      max-width: 560px;
    }
    .invoice-form label { display: flex; flex-direction: column; gap: 4px; font-size: 0.88rem; color: #565e6c; }
    .invoice-form input, .invoice-form select { padding: 8px 10px; border: 1px solid #dde1e8; }
    .invoice-form button {
      grid-column: 1 / -1;
      justify-self: start;
      background: #334ba4;
      color: #fff;
      border: none;
      padding: 10px 20px;
      cursor: pointer;
    }
    .error { grid-column: 1 / -1; color: #b3261e; font-size: 0.85rem; margin: 0; }
    .empty { color: #565e6c; }
    table { width: 100%; border-collapse: collapse; background: #fff; }
    th, td { text-align: left; padding: 10px 14px; border-bottom: 1px solid #eef1f7; font-size: 0.92rem; }
    th { color: #565e6c; font-weight: normal; }
    .badge { padding: 2px 8px; font-size: 0.78rem; border-radius: 2px; background: #eef1f7; color: #565e6c; }
    .badge-pagada { background: #e3f4e8; color: #1e6b3a; }
    .badge-vencida { background: #fbe4e1; color: #a13a2a; }
  </style>
</AdminLayout>
