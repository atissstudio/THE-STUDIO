---
import PortalLayout from "../../layouts/PortalLayout.astro";
import { requireClient } from "../../lib/requireClient";

export const prerender = false;

const { redirect, supabase, cliente } = await requireClient(Astro);
if (redirect) return redirect;

const { data: facturas } = await supabase!
  .from("facturas")
  .select("id, numero, concepto, importe, estado, fecha_emision, fecha_vencimiento")
  .eq("cliente_id", cliente!.id)
  .order("fecha_emision", { ascending: false });
---

<PortalLayout title="Facturas — Portal de cliente" path="/portal/facturas" userName={cliente!.nombre}>
  <a href="/portal" class="back">← Portal</a>
  <h1>Facturas</h1>
  <p class="lead">El estado de tus facturas con The Studio.</p>

  {!facturas?.length ? (
    <p class="empty">Todavía no hay facturas.</p>
  ) : (
    <ul class="list">
      {facturas.map((f) => (
        <li>
          <div>
            <span class="name">{f.numero} — {f.concepto}</span>
            <span class="date">
              Emitida el {new Date(f.fecha_emision).toLocaleDateString("es-ES")}
              {f.fecha_vencimiento ? ` · vence el ${new Date(f.fecha_vencimiento).toLocaleDateString("es-ES")}` : ""}
            </span>
          </div>
          <div class="amount-wrap">
            <span class="amount">{Number(f.importe).toFixed(2)} €</span>
            <span class={`type badge-${f.estado}`}>{f.estado}</span>
          </div>
        </li>
      ))}
    </ul>
  )}
</PortalLayout>

<style>
  .back {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--muted-on-dark);
    text-decoration: none;
    margin: 20px 0 8px;
  }
  .back:hover {
    color: var(--azul-lit);
  }
  h1 {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    margin: 0 0 8px;
  }
  .lead {
    font-family: var(--sans);
    color: var(--muted-on-dark);
    font-style: italic;
    font-size: 0.92rem;
    margin: 0 0 28px;
  }
  .empty {
    font-family: var(--sans);
    color: var(--muted-on-dark);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 16px 20px;
  }
  .name {
    display: block;
    font-family: var(--sans);
    font-weight: 700;
    color: var(--ink);
    font-size: 0.94rem;
  }
  .date {
    display: block;
    font-family: var(--sans);
    color: var(--muted);
    font-size: 0.78rem;
    margin-top: 4px;
  }
  .amount-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .amount {
    font-family: var(--sans);
    font-weight: 700;
    color: var(--ink);
    font-size: 0.95rem;
  }
  .type {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--azul-deep);
    background: rgba(51, 75, 164, 0.1);
    border-radius: 20px;
    padding: 5px 12px;
    white-space: nowrap;
  }
  .badge-pagada { color: #1e6b3a; background: rgba(30, 107, 58, 0.12); }
  .badge-vencida { color: #a13a2a; background: rgba(161, 58, 42, 0.12); }
</style>
