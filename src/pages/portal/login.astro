---
import "../../styles/tokens.css";
import Logo from "../../components/Logo.astro";
import GlassButton from "../../components/GlassButton.astro";
import { createSupabaseServerClient } from "../../lib/supabase";

export const prerender = false;

let error = "";
let sent = false;

const urlError = Astro.url.searchParams.get("error");
if (urlError === "sin-acceso") error = "Ese correo no tiene una ficha de cliente asociada. Contacta con nosotros.";
if (urlError === "enlace-invalido") error = "El enlace ha caducado o no es válido. Pide uno nuevo.";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "").trim();

  if (!email || !email.includes("@")) {
    error = "Escribe un correo válido.";
  } else {
    try {
      const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
      const { error: otpError } = await supabase.auth.signInWithOtp({
        email,
        options: { emailRedirectTo: `${Astro.url.origin}/portal/auth/confirm` },
      });
      if (otpError) error = otpError.message;
      else sent = true;
    } catch {
      error = "El portal no está conectado todavía (faltan las claves de Supabase).";
    }
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet" />
    <title>Acceso — Portal de cliente — The Studio, by Atis</title>
  </head>
  <body class="portal-login-body">
    <section class="login-wrap">
      <div class="login-logo"><Logo size="1.6rem" /></div>
      <p class="kick">Portal de cliente</p>
      <h1>Entra a tu portal</h1>

      {sent ? (
        <p class="lead">
          Te hemos mandado un enlace a tu correo. Ábrelo desde este mismo dispositivo para entrar —
          caduca a los 60 minutos.
        </p>
      ) : (
        <>
          <p class="lead">Escribe el correo con el que te dimos de alta y te mandamos un enlace de acceso.</p>
          <form method="POST">
            <label>
              Correo
              <input type="email" name="email" autocomplete="email" required />
            </label>
            {error && <p class="error">{error}</p>}
            <GlassButton type="submit">Enviar enlace</GlassButton>
          </form>
        </>
      )}
    </section>

    <style>
      .portal-login-body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--f-azul, #334ba4);
      }
      .login-wrap {
        max-width: 420px;
        margin: 0 auto;
        padding: 40px 32px;
        text-align: center;
        background: #fff;
        border-radius: 18px;
      }
      .login-logo { margin-bottom: 24px; }
      .kick {
        font-family: var(--sans);
        font-size: 0.72rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--azul-lit);
        font-weight: 700;
        margin: 0 0 12px;
      }
      h1 {
        font-family: var(--sans);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: -0.01em;
        font-size: clamp(1.5rem, 4vw, 2rem);
        margin: 0 0 12px;
      }
      .lead {
        font-family: var(--sans);
        color: var(--muted);
        font-style: italic;
        font-size: 0.92rem;
        margin: 0 0 28px;
      }
      form { display: flex; flex-direction: column; gap: 16px; text-align: left; }
      label {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-family: var(--sans);
        font-size: 0.8rem;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }
      input {
        font-family: var(--sans);
        font-size: 0.95rem;
        font-weight: 400;
        text-transform: none;
        letter-spacing: normal;
        background: #f4f5f7;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 11px 14px;
        color: var(--ink);
      }
      .error {
        font-family: var(--sans);
        font-size: 0.82rem;
        font-weight: 700;
        color: #b4433a;
        background: rgba(180, 67, 58, 0.1);
        border-radius: 10px;
        padding: 10px 14px;
        margin: 0;
      }
      form :global(.glass) { align-self: center; margin-top: 4px; }
    </style>
  </body>
</html>
