---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/GlassButton.astro";
import SobreAtisHistoria from "../components/SobreAtisHistoria.astro";
---

<BaseLayout
  title="Sobre Atis. De dónde venimos y por qué volvimos"
  description="Crecimos en un paraíso que veíamos apagarse y decidimos volver. Así nació Atis Studio: una cooperativa que devuelve a Canarias las herramientas de los más grandes."
  path="/sobre-atis"
>
  <SobreAtisHistoria />

  <section class="f-azul closer row12">
    <div class="closer-inner">
      <p class="k">El desenlace</p>
      <h2>Tu momento es ahora.</h2>
      <p>
        No importa de dónde vengas ni el tamaño de tu empresa. Si compartes nuestra visión y quieres
        que tu negocio crezca en Canarias sin perder su esencia, estamos listos para acompañarte.
      </p>
      <GlassButton href="/contacto">Hablemos de tu proyecto</GlassButton>
      <p class="sidelinks">
        <a href="/como-trabajamos">Cómo trabajamos</a>
        <a href="/servicios">Servicios</a>
        <a href="/casos">Los datos</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .sidelinks {
    margin: 26px 0 0;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 18px;
  }
  .sidelinks a {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-on-dark);
    text-decoration: none;
  }
  .sidelinks a:hover {
    color: var(--azul-lit);
  }
</style>
