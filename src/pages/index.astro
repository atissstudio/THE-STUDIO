---
import BaseLayout from "../layouts/BaseLayout.astro";
import Kicker from "../components/Kicker.astro";
import Highlight from "../components/Highlight.astro";
import GlassButton from "../components/GlassButton.astro";
import PainCarousel from "../components/PainCarousel.astro";

const painCards = [
  {
    sector: "Dental",
    text: "Pierdes entre el 20 y el 30% de tus pacientes al año por falta de seguimiento. Un recordatorio automático por WhatsApp reduce los no-shows hasta un 80%.",
    source: "INV-01 / INV-02",
  },
  {
    sector: "Dental",
    text: "Solo aceptas entre el 35 y el 50% de los presupuestos que propones. El seguimiento automático sube la aceptación hasta un 30%.",
    source: "INV-01",
  },
  {
    sector: "Dental",
    text: "Un paciente vale de media 2.160€ para tu clínica. Captarlo cuesta 65-135€ — automatizar el seguimiento se recupera en el primer mes.",
    source: "INV-01",
  },
  {
    sector: "Reformas",
    text: "Más de la mitad de los leads se pierden por no responder a tiempo. Contactar en menos de 5 minutos multiplica por 21 las posibilidades de cerrar.",
    source: "INV-01 (HBR)",
  },
  {
    sector: "Reformas",
    text: "Tu margen neto ronda el 3-7%. Cada presupuesto que se pierde por falta de seguimiento es margen que no vuelve.",
    source: "INV-02",
  },
  {
    sector: "Reformas",
    text: "Un presupuesto desglosado y rápido sube la aceptación — en un comprador racional, la confianza pesa más que el precio.",
    source: "INV-02",
  },
];
---

<BaseLayout
  title="The Studio, by Atis — Comunicación, Marketing e IA en Canarias"
  description="Auditamos, ordenamos y activamos tu marca con IA que te quita el trabajo pesado y te devuelve el tiempo. Consultoría de comunicación, marketing e IA para negocios en Canarias."
  path="/"
>
  <!-- 1. Hook -->
  <section class="hero">
    <Kicker>Comunicación · Marketing · IA — en Canarias</Kicker>
    <h1>Tu negocio ya vale. Vamos a que se note.</h1>
    <p class="lead">
      Auditamos, ordenamos y activamos tu marca con <Highlight>ia</Highlight> que te quita el trabajo
      pesado y te devuelve el tiempo. Y te explicamos <Highlight>cada paso</Highlight>, porque nadie
      conoce tu negocio como tú.
    </p>
    <div class="cta">
      <GlassButton href="/contacto">Pídeme tu plan gratis</GlassButton>
      <a class="link" href="#como-lo-hacemos">Ver cómo trabajamos &rarr;</a>
    </div>
  </section>

  <!-- 2. WHY -->
  <section class="why">
    <Kicker>Por qué existimos</Kicker>
    <h2>No creemos que un negocio valga por lo que factura.</h2>
    <p>
      Creemos que un negocio vale por lo que aporta a las personas, su cultura, su economía y su
      entorno. Existimos para ayudar a quien tiene un valor enorme y aún no ha aprendido a
      mostrarlo — no al que ya tiene de sobra. Ponemos orden, explicamos el porqué de cada decisión
      y te devolvemos el control de tu marca, porque <Highlight>nadie conoce un negocio como quien
        lo levantó</Highlight>.
    </p>
    <a class="link" href="/sobre-atis">Ver más → Sobre Atis</a>
  </section>

  <!-- 3. HOW -->
  <section id="como-lo-hacemos" class="feature">
    <span class="ky">Cómo lo hacemos</span>
    <h2 class="feature-title">Un proceso, sin humo</h2>
    <div class="steps">
      <div class="step">
        <div class="ic">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="M16 16l5 5"
            ></path></svg>
        </div>
        <div class="step-title">Auditoría</div>
        <p>Miramos tu negocio con datos y te decimos la verdad.</p>
      </div>
      <div class="step">
        <div class="ic">
          <svg viewBox="0 0 24 24"><circle cx="9" cy="12" r="6"></circle><circle
              cx="15"
              cy="12"
              r="6"></circle></svg>
        </div>
        <div class="step-title">Branding</div>
        <p>Ordenamos lo que eres para que se note que eres serio.</p>
      </div>
      <div class="step">
        <div class="ic">
          <svg viewBox="0 0 24 24"
            ><path d="M3 16.5c3.5-.5 4-8.5 7-8.5s3 7.5 7 7.5c1.7 0 2.7-1.3 4-3"></path></svg>
        </div>
        <div class="step-title">Marketing + IA</div>
        <p>Automatizamos lo pesado y traemos clientes de verdad.</p>
      </div>
    </div>
    <a class="link" href="/como-trabajamos">Ver más → Cómo trabajamos</a>
  </section>

  <!-- 4. WHAT -->
  <section class="what">
    <Kicker>Qué hacemos</Kicker>
    <h2>Servicios</h2>
    <div class="service-grid">
      <a class="service-card" href="/servicios/auditoria">
        <span class="service-title">Auditoría</span>
        <p>El punto de partida: qué te frena, con datos, sin humo.</p>
        <span class="link">Ver más →</span>
      </a>
      <a class="service-card" href="/servicios/branding">
        <span class="service-title">Branding</span>
        <p>Ordenamos lo que eres para que se note que eres serio.</p>
        <span class="link">Ver más →</span>
      </a>
      <a class="service-card" href="/servicios/marketing-ia">
        <span class="service-title">Marketing + IA</span>
        <p>Automatizamos lo pesado y traemos clientes de verdad.</p>
        <span class="link">Ver más →</span>
      </a>
    </div>
    <a class="link" href="/servicios">Ver todos los servicios →</a>
  </section>

  <!-- 5. Prueba social -->
  <section class="proof">
    <Kicker>Resultados</Kicker>
    <h2>No hablamos por hablar</h2>
    <p class="lead-small">Datos reales del sector, citados a nuestra propia investigación.</p>
    <PainCarousel cards={painCards} />
    <a class="link" href="/casos">Ver más → Casos</a>
  </section>

  <!-- 6. CTA final -->
  <section class="popup">
    <div class="who">
      <span class="av">T</span>
      <span class="whoname"><b>El tío, de The Studio</b>te lee al entrar</span>
    </div>
    <p class="msg">
      No te lo pienses sin antes saber <Highlight>cómo beneficiaría a tu negocio.</Highlight> Déjame
      tu correo y te mando un <Highlight>plan gratis</Highlight>, hecho para ti.
    </p>
    <form class="form" action="/api/lead" method="post">
      <input type="email" name="email" placeholder="tu@correo.com" aria-label="Tu correo" required />
      <GlassButton type="submit" withDot={false}>Envíamelo</GlassButton>
    </form>
    <p class="sign">— y sin compromiso, que no muerdo.</p>
  </section>
</BaseLayout>

<style>
  section {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }
  h1,
  h2 {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-wrap: balance;
    margin: 0;
  }
  p {
    font-family: var(--sans);
  }
  .link {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--azul);
    font-weight: 700;
    font-size: 0.82rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .hero {
    padding: 44px 0 30px;
  }
  .hero h1 {
    font-size: clamp(2rem, 5.2vw, 3.1rem);
  }
  .hero .lead {
    font-size: 1.06rem;
    color: #3a4250;
    max-width: 48ch;
    margin: 18px auto 26px;
    text-align: justify;
    text-align-last: center;
  }
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .why {
    padding: 30px 24px;
  }
  .why h2 {
    font-size: 1.6rem;
    margin: 10px 0 18px;
  }
  .why p {
    text-align: justify;
    text-align-last: center;
    max-width: 56ch;
    margin: 0 auto;
    color: #3a4250;
  }

  .feature {
    background: var(--panel);
    border: 1px solid rgba(51, 75, 164, 0.12);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    margin: 16px auto;
  }
  .feature .ky {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--azul);
    font-weight: 700;
  }
  .feature-title {
    font-size: 1.7rem;
    margin: 8px 0 24px;
    color: var(--ink);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
  .step {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(51, 75, 164, 0.1);
    border-radius: 14px;
    padding: 20px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .step .ic {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    margin-bottom: 12px;
    filter: drop-shadow(0 2px 3px rgba(86, 94, 108, 0.35));
  }
  .step .ic svg {
    width: 26px;
    height: 26px;
  }
  .step .ic path,
  .step .ic circle {
    stroke: url(#plataLiquida);
    stroke-width: 1.6;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .step-title {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
    margin-bottom: 5px;
  }
  .step p {
    margin: 0;
    font-size: 0.82rem;
    color: #4c5462;
    line-height: 1.5;
  }

  .what {
    padding: 40px 24px;
  }
  .what h2 {
    font-size: 1.7rem;
    margin: 8px 0 24px;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: var(--space-5);
  }
  @media (max-width: 640px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
  }
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 24px 18px;
    transition: transform 0.2s ease;
  }
  .service-card:hover {
    transform: translateY(-2px);
  }
  .service-title {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .service-card p {
    font-size: 0.86rem;
    color: var(--muted);
    margin: 0 0 8px;
  }

  .proof {
    padding: 40px 24px;
  }
  .proof h2 {
    font-size: 1.7rem;
    margin: 8px 0 6px;
  }
  .lead-small {
    color: var(--muted);
    font-size: 0.88rem;
    margin: 0 0 24px;
  }

  .popup {
    max-width: 420px;
    margin: 40px auto;
    background: var(--panel-strong);
    border: 1px solid rgba(51, 75, 164, 0.14);
    border-radius: 20px;
    padding: 26px;
    box-shadow: 0 26px 50px -28px rgba(37, 55, 111, 0.5);
  }
  .who {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .av {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg, #eef1f7, #aeb4c0);
    display: grid;
    place-items: center;
    font-family: var(--script);
    color: #3a3f47;
    font-size: 1.4rem;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6);
  }
  .whoname {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--muted);
    text-align: left;
  }
  .whoname b {
    color: var(--ink);
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .msg {
    color: #2a3140;
    font-size: 1rem;
    line-height: 1.5;
    margin: 0 auto 16px;
    text-align: justify;
    text-align-last: center;
    max-width: 34ch;
  }
  .form {
    display: flex;
    gap: 8px;
  }
  .form input {
    flex: 1;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(51, 75, 164, 0.16);
    border-radius: 12px;
    padding: 11px 14px;
    color: var(--ink);
    font-family: var(--sans);
    font-size: 0.88rem;
    text-align: center;
  }
  .sign {
    margin: 14px 0 0;
    font-family: var(--script);
    color: #6a7280;
    font-size: 1.15rem;
  }
</style>
