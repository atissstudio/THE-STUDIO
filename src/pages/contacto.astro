---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import GlassButton from "../components/GlassButton.astro";
import Highlight from "../components/Highlight.astro";

const ok = Astro.url.searchParams.get("ok") === "1";
const error = Astro.url.searchParams.get("error") === "1";
---

<BaseLayout
  title="Contacto — The Studio, by Atis"
  description="Pide tu plan gratis: cuéntanos tu negocio y te decimos, sin compromiso, por dónde empezaríamos."
  path="/contacto"
>
  <PageHero kicker="Contacto" title="Pídeme tu plan gratis">
    <p class="lead">
      Déjame tu correo y te mando un <Highlight>plan gratis</Highlight>, hecho para ti. Sin compromiso.
    </p>
  </PageHero>

  <section class="form-wrap">
    {ok && <p class="notice ok">Recibido — te escribimos en breve con tu plan gratis.</p>}
    {error && <p class="notice error">Algo ha fallado al enviarlo. Prueba otra vez o escríbenos directamente.</p>}
    <form action="/api/lead" method="post">
      <label>
        Tu nombre
        <input type="text" name="name" required />
      </label>
      <label>
        Tu correo
        <input type="email" name="email" placeholder="tu@correo.com" required />
      </label>
      <label>
        Tu negocio
        <input type="text" name="business" />
      </label>
      <label>
        Cuéntanos brevemente qué te trae por aquí (opcional)
        <textarea name="message" rows="4"></textarea>
      </label>
      <GlassButton type="submit">Envíamelo</GlassButton>
      <p class="privacy">
        Solo usamos tu correo para enviarte el plan y hablar contigo — nunca lo compartimos con
        terceros.
      </p>
    </form>
  </section>
</BaseLayout>

<style>
  .lead {
    font-size: 1.05rem;
    color: var(--muted);
    text-align: center;
    max-width: 44ch;
    margin: 0 auto;
  }
  .form-wrap {
    max-width: 480px;
    margin: 30px auto 64px;
    padding: 0 24px;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: var(--sans);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  input,
  textarea {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 11px 14px;
    color: var(--ink);
  }
  textarea {
    resize: vertical;
  }
  .notice {
    font-family: var(--sans);
    font-size: 0.88rem;
    font-weight: 700;
    text-align: center;
    border-radius: 12px;
    padding: 12px 16px;
    margin: 0 0 20px;
  }
  .notice.ok {
    background: rgba(51, 75, 164, 0.1);
    color: var(--azul-deep);
  }
  .notice.error {
    background: rgba(180, 67, 58, 0.1);
    color: #b4433a;
  }
  .privacy {
    font-family: var(--sans);
    font-size: 0.76rem;
    font-weight: 400;
    text-transform: none;
    letter-spacing: normal;
    color: var(--muted);
    text-align: center;
    margin: 4px 0 0;
  }
</style>
