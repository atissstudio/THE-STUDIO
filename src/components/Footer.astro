---
import Logo from "./Logo.astro";

const links = [
  { href: "/sobre-atis", label: "Sobre Atis" },
  { href: "/como-trabajamos", label: "Cómo trabajamos" },
  { href: "/servicios", label: "Servicios" },
  { href: "/casos", label: "Casos" },
  { href: "/contacto", label: "Contacto" },
];

// Aún sin cuentas reales confirmadas — solo el icono, sin enlace, hasta que existan (2026-07-10).
const socials = [
  { label: "Instagram", d: "M12 8a4 4 0 100 8 4 4 0 000-8Z M7 3h10a4 4 0 014 4v10a4 4 0 01-4 4H7a4 4 0 01-4-4V7a4 4 0 014-4Z M16.5 7.5h.01" },
  { label: "LinkedIn", d: "M6.5 9v9M6.5 5.5v.01M11 18V9M11 12.5c0-2 1.5-3.5 3.5-3.5s3.5 1.5 3.5 3.5V18" },
];

const year = new Date().getFullYear();
---

<footer>
  <a href="/" aria-label="The Studio, by Atis — inicio">
    <Logo size="1.05rem" />
  </a>
  <nav aria-label="Navegación de pie de página">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="socials" aria-label="Redes sociales (próximamente)">
    {
      socials.map((s) => (
        <span class="social-ic" title={`${s.label} — próximamente`} aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d={s.d}></path>
          </svg>
        </span>
      ))
    }
  </div>

  <div class="legal">
    <a href="/legal/aviso-legal">Aviso legal</a>
    <a href="/legal/privacidad">Política de privacidad</a>
    <a href="/legal/cookies">Cookies</a>
  </div>

  <small>© {year} The Studio, by Atis · Canarias</small>
</footer>

<style>
  /*
    El pie va FIJO por detrás de la página (#page, que lleva margin-bottom para
    reservarle el hueco). Al llegar al final del scroll, la página se levanta y
    lo va descubriendo. Restaurado de la maqueta aprobada el 2026-08-03.
    El navy sigue siendo solo del pie, nunca el lienzo de la página.
  */
  footer {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1;
    height: var(--foot-h);
    background: var(--navy);
    color: var(--plata-clara);
    margin-top: 0;
    padding: 48px 24px 40px;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  footer > * {
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }
  footer nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin: 16px 0 0;
    padding: 0;
  }
  footer nav a {
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted-on-dark);
  }
  footer nav a:hover {
    color: var(--azul-lit);
  }
  .socials {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 20px;
  }
  .social-ic {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    cursor: default;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.35));
  }
  .social-ic svg {
    width: 20px;
    height: 20px;
  }
  .social-ic path {
    stroke: url(#plataLiquida);
    stroke-width: 1.6;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .legal {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 18px;
  }
  .legal a {
    font-family: var(--sans);
    font-size: 0.68rem;
    letter-spacing: 0.02em;
    color: var(--muted-on-dark);
    text-decoration: none;
    opacity: 0.75;
  }
  .legal a:hover {
    opacity: 1;
    color: var(--azul-lit);
  }
  footer small {
    display: block;
    font-family: var(--sans);
    color: var(--muted-on-dark);
    font-size: 0.76rem;
    margin-top: 16px;
  }

  /*
    ⚠️ EN MÓVIL EL PIE ES LA ÚLTIMA DIAPOSITIVA, NO UNA REVELACIÓN (2026-08-21).

    El pie va fijo por detrás y se descubre en los últimos 300 px que `#page`
    reserva con su margen. Eso funciona con scroll libre, pero al pasar el móvil
    a ajuste OBLIGATORIO esos 300 px dejan de ser alcanzables: no son ninguna
    parada, así que el navegador devuelve el scroll a la última y **el pie no se
    puede ver**. Medido: el scroll se quedaba en 12.028 de 12.328, con los
    enlaces legales y la navegación fuera de alcance.

    Así que en móvil deja de ir fijo: se coloca al final del documento como un
    bloque más y es la última parada. El pie es contenido, no un truco.
  */
  @media (max-width: 900px) {
    footer {
      position: static;
      height: auto;
      padding-bottom: 28px;
      scroll-snap-align: end;
      scroll-snap-stop: always;
    }
  }
</style>
