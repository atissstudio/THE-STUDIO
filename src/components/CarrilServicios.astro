---
/*
  Carril de fichas de servicio (2026-08-11).

  Por qué carril y no lista vertical: siete servicios en vertical son siete
  pantallas de scroll y el visitante abandona antes de llegar al cuarto. En
  horizontal caben en una pantalla y el borde derecho, siempre cortado, es lo
  que dice "hay más" sin necesidad de escribirlo.

  Medido sobre la referencia (lorolabs.ai, 2026-08-11): su carril NO lleva
  ajuste por diapositivas, es scroll libre con flechas. Aquí se pone
  `proximity`, que es la versión suave: acompaña a que las fichas queden
  alineadas pero nunca frena el dedo ni secuestra el gesto.

  Las flechas van sin caja y con 44x44 de zona pulsable, que es el mínimo
  recomendado y uno de los puntos que teníamos abiertos de la auditoría.
*/
import FichaServicio from "./FichaServicio.astro";
import { servicios } from "../data/servicios";

/*
  Props (2026-08-21). El carril nació pegado a /servicios, con su propio campo
  claro y su titular escrito dentro. Para poder montarlo también en la
  diapositiva `.05` de la home hacía falta que el texto y el campo vengan de
  fuera: `desnudo` quita el campo propio (lo pone la sección que lo acoge) y
  `kicker`/`titulo`/`enlace` se pasan desde donde se use.
*/
interface Props {
  kicker?: string;
  titulo?: string;
  enlace?: { href: string; texto: string };
  desnudo?: boolean;
}
const {
  kicker = "El catálogo",
  titulo = "Siete servicios, una sola puerta de entrada.",
  enlace,
  desnudo = false,
} = Astro.props;
---

<section class:list={["carril-campo", { "f-claro": !desnudo, desnudo }]}>
  <div class="row12">
    <div class="cab">
      <p class="k">{kicker}</p>
      <div class="cab-fila">
        <h2>{titulo}</h2>
        <div class="flechas">
          <button type="button" class="fl" data-dir="-1" aria-label="Ver los servicios anteriores">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path>
            </svg>
          </button>
          <button type="button" class="fl" data-dir="1" aria-label="Ver los servicios siguientes">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
      {enlace && (
        <a class="head-link" href={enlace.href}>
          {enlace.texto}
        </a>
      )}
    </div>
  </div>

  <div class="carril" data-carril>
    {
      servicios.map((s, i) => (
        <FichaServicio
          slug={s.slug}
          title={s.title}
          card={s.card}
          entregable={s.entregable}
          isla={s.isla}
          foto={s.foto}
          indice={i}
          total={servicios.length}
        />
      ))
    }
  </div>
</section>

<style>
  .carril-campo {
    /*
      Abajo, poco: el carril ya reserva 22 px para su sombra y debajo viene
      otro campo claro con su propio respiro arriba. Con `--row` entero, entre
      la última ficha y el texto de abajo quedaban 189 px de claro sin nada,
      que es el hueco raro que se veía en producción.
    */
    padding: calc(var(--row) * 0.9) 0 calc(var(--row) * 0.4);
    /* clip, nunca hidden: `hidden` convierte al elemento en contenedor de
       scroll y rompe cualquier sticky de dentro (trampa ya documentada). */
    overflow-x: clip;
  }

  .cab {
    grid-column: 2/12;
    padding: 0 20px;
    margin-bottom: 38px;
  }
  .cab-fila {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
  }
  .cab h2 {
    margin: 0;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: none;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    max-width: 22ch;
    text-wrap: pretty;
  }

  .flechas {
    display: flex;
    gap: 4px;
    flex: 0 0 auto;
  }
  /*
    Sin caja y con el trazo en azul: el icono es curva, la caja es pico (regla
    del manual). La zona pulsable son 44x44 aunque el dibujo mida 22.
  */
  .fl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--azul);
    cursor: pointer;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .fl:hover {
    transform: translateY(-1px);
  }
  .fl:focus-visible {
    outline: 2px solid var(--azul);
    outline-offset: 2px;
  }
  .fl[aria-disabled="true"] {
    opacity: 0.28;
    cursor: default;
    transform: none;
  }

  .carril {
    display: flex;
    /* Separadas, no pegadas: son fichas que flotan, no tarjetas a sangre. */
    gap: 20px;
    /* Sitio para que la sombra y el desplazamiento al pasar el ratón no se
       vean recortados por el borde del contenedor de scroll. */
    padding-top: 12px;
    padding-bottom: 22px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    /* Arranca donde arranca el texto (una columna + su margen) y termina a
       sangre por la derecha, para que la última ficha quede cortada. */
    padding-left: calc(100% / 12 + 20px);
    /*
      ⚠️ Sin esto el ajuste se come el margen. `scroll-snap-align: start`
      alinea la ficha con el principio de la ZONA de scroll, que por defecto
      es el borde del contenedor y no su relleno: el navegador desplazaba el
      carril 123 px él solo y la primera ficha quedaba pegada al borde
      izquierdo de la pantalla, cortada. Visto en pantalla, no medido.
      `scroll-padding-left` mueve esa zona hasta donde arranca el contenido.
    */
    scroll-padding-left: calc(100% / 12 + 20px);
    /* La barra de scroll del sistema partiría el campo en dos. La orientación
       ya la dan las flechas y la ficha cortada. */
    scrollbar-width: none;
  }
  .carril::-webkit-scrollbar {
    display: none;
  }

  /*
    ══ MODO DESNUDO: el carril dentro de una diapositiva ajena ══════════════

    En la home el carril vive en `.05`, que es campo de ROCA y mide una
    pantalla exacta. Así que aquí no pone campo ni aire propio: el aire lo pone
    la pantalla, y los colores los hereda del campo que lo acoge. El titular
    iba en tinta casi negra —bien sobre claro, invisible sobre roca—, de modo
    que en modo desnudo hereda el color del campo, que sobre roca es plata
    clara (9,4 de contraste, medido el 2026-08-21).
  */
  .carril-campo.desnudo {
    padding: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    /*
      ⚠️ NADA DE `height: 100%` AQUÍ. La sección que lo acoge se dimensiona con
      `min-height` en móvil, y un porcentaje no resuelve contra un `min-height`:
      se queda en "auto", o sea el alto del contenido, y el carril se pegaba
      arriba con 262 px de roca vacía debajo. Estirando por flex (la sección va
      en flex y esto es su único hijo) funciona con las dos formas de medir.
    */
    align-self: stretch;
    /*
      ⚠️ `min-width: 0` NO ES DECORATIVO: SIN ÉL, ESTA SECCIÓN MIDE LO QUE MIDE
      EL CARRIL ENTERO. Un elemento dentro de un flex no encoge por debajo del
      tamaño de su contenido salvo que se le diga, y el contenido aquí son
      siete fichas en fila: medido en la home a 390 px de ancho, la sección
      media 2338. Eso es lo que dejaba arrastrar la página de lado y asomar la
      franja blanca que Alejandro veía en el iPhone.
    */
    min-width: 0;
  }
  .carril-campo.desnudo > .row12 {
    min-width: 0;
  }
  .desnudo .cab {
    margin-bottom: 26px;
  }
  .desnudo .cab h2 {
    color: inherit;
  }
  .desnudo .fl {
    color: currentColor;
  }
  .desnudo .fl:focus-visible {
    outline-color: currentColor;
  }
  /* El enlace del enunciado, el mismo de las tarjetas de campo de la home. */
  .head-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.72;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
  }
  .head-link:hover {
    opacity: 1;
  }

  @media (max-width: 900px) {
    /*
      En móvil el campo mide una pantalla entera por la regla general de
      tokens.css, y el carril no la llena: quedaba un vacío claro de unos 250 px
      debajo. Centrando el contenido en el campo, el aire se reparte arriba y
      abajo y deja de leerse como un hueco.
    */
    .carril-campo {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: calc(var(--row) * 0.6) 0;
    }
    .cab {
      grid-column: 1/13;
      margin-bottom: 26px;
    }
    .cab-fila {
      display: block;
    }
    /* Con el dedo se desliza, así que las flechas sobran y ocupan sitio. */
    .flechas {
      display: none;
    }
    .carril {
      padding-left: 20px;
      scroll-padding-left: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carril {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  /*
    Entrada de las fichas, calcada del gesto de la referencia (medido sobre su
    DOM el 2026-08-11): llegan desenfocadas, un poco más abajo y algo más
    pequeñas, y se colocan en cascada. No usa `escalonar` porque esa función
    solo mueve posición y opacidad, y aquí el desenfoque es justo lo que hace
    que parezca que la ficha "enfoca" al entrar.

    ⚠️ Red de seguridad obligatoria: la animación parte de opacidad cero, así
    que si el observador no llegara a disparar, el catálogo entero sería
    invisible para siempre. A los 6 s, al imprimir y al volver de segundo
    plano se enciende pase lo que pase.
  */
  {
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fichas = gsap.utils.toArray<HTMLElement>(".carril .ficha");

    if (!quieto && fichas.length) {
      const entrada = gsap.from(fichas, {
        scrollTrigger: { trigger: fichas[0], start: "top 88%", once: true },
        y: 34,
        scale: 0.94,
        opacity: 0,
        filter: "blur(8px)",
        duration: 0.8,
        ease: "power2.out",
        stagger: 0.08,
      });

      const encender = () => {
        if (entrada.progress() === 0) entrada.progress(1);
      };
      setTimeout(encender, 6000);
      addEventListener("beforeprint", encender);
      addEventListener("visibilitychange", () => {
        if (!document.hidden) setTimeout(encender, 1200);
      });
    }
  }

  {
    const carril = document.querySelector<HTMLElement>("[data-carril]");
    const flechas = Array.from(document.querySelectorAll<HTMLButtonElement>(".fl"));

    if (carril && flechas.length) {
      // El paso es una ficha, medida del propio elemento. Nada a ojo.
      const paso = () => carril.querySelector<HTMLElement>(".ficha")?.offsetWidth ?? 400;

      const pintar = () => {
        const fin = carril.scrollWidth - carril.clientWidth;
        flechas.forEach((f) => {
          const dir = Number(f.dataset.dir);
          const tope = dir < 0 ? carril.scrollLeft <= 1 : carril.scrollLeft >= fin - 1;
          f.setAttribute("aria-disabled", String(tope));
        });
      };

      flechas.forEach((f) => {
        f.addEventListener("click", () => {
          if (f.getAttribute("aria-disabled") === "true") return;
          carril.scrollBy({ left: Number(f.dataset.dir) * paso() });
        });
      });

      carril.addEventListener("scroll", pintar, { passive: true });
      addEventListener("resize", pintar);
      pintar();
    }
  }
</script>
