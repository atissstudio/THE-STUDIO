---
/*
  ══ LA PINTADERA ═════════════════════════════════════════════════════════════

  El puntero del sitio es una pintadera canaria: el sello triangular con el que
  los antiguos canarios estampaban. Es lo más nuestro que se puede poner en un
  cursor, y además es geometría pura, así que encaja con v5 sin discutir.

  Comportamiento pedido: cuando el ratón se queda quieto un rato, la pintadera
  empieza a GIRAR SOBRE SÍ MISMA, como un sello que se va colocando. Al mover,
  se para.

  Frenos, a propósito:
    · Solo donde hay un puntero de verdad (`pointer: fine`). En un móvil no se
      monta: no hay cursor que sustituir y taparía el dedo.
    · Con "menos movimiento" no se monta nada y manda el cursor del sistema.
    · Sobre campos de texto vuelve el cursor nativo: ahí la barra de escritura
      dice dónde vas a escribir, y eso no se puede quitar.
    · Solo `transform` y `opacity`.
*/

/*
  La retícula se calcula, no se escribe a mano: cuatro filas de triángulos
  sobre un triángulo INTERIOR, encogido hacia el centro.

  ⚠️ Tiene que ir por dentro del marco. Con la retícula sobre el triángulo
  exterior, el filete grueso que redondea las esquinas se comía las líneas de
  fuera y lo que quedaba en el centro se leía como una estrella, no como una
  pintadera. En el sello real también hay marco liso alrededor del dibujo.
*/
const A = { x: 50, y: 4 };
const B = { x: 6, y: 83 };
const C = { x: 94, y: 83 };
const G = { x: (A.x + B.x + C.x) / 3, y: (A.y + B.y + C.y) / 3 };
const dentro = (p: { x: number; y: number }, k = 0.74) => ({
  x: G.x + (p.x - G.x) * k,
  y: G.y + (p.y - G.y) * k,
});
const a = dentro(A);
const b = dentro(B);
const c = dentro(C);
const entre = (p: typeof a, q: typeof a, t: number) => ({
  x: p.x + (q.x - p.x) * t,
  y: p.y + (q.y - p.y) * t,
});
// Tres familias de paralelas, una por lado. Cuatro filas = 16 triángulos.
/*
  ⚠️ TRES FILAS, NO CUATRO. A tamaño de cursor (20 px) dieciséis triángulos se
  empastan y no se lee nada: hay que quitar dibujo, no añadirlo. Con nueve, la
  pintadera se reconoce de un vistazo.
*/
const lineas = [1, 2].flatMap((k) => {
  const t = k / 3;
  return [
    [entre(a, b, t), entre(a, c, t)], // paralelas a la base
    [entre(a, c, t), entre(b, c, t)], // paralelas al lado izquierdo
    [entre(a, b, t), entre(c, b, t)], // paralelas al lado derecho
  ];
});
---


<div id="pintadera" aria-hidden="true">
  <svg viewBox="0 0 100 87" role="presentation">
    {/* La silueta, con las esquinas romas del sello real. */}
    <path
      d={`M${A.x} ${A.y} L${C.x} ${C.y} L${B.x} ${B.y} Z`}
      fill="var(--plata-clara)"
      stroke="var(--plata-clara)"
      stroke-width="8"
      stroke-linejoin="round"
    />
    {/* El dibujo, dentro del marco. */}
    <path
      d={`M${a.x} ${a.y} L${c.x} ${c.y} L${b.x} ${b.y} Z`}
      fill="none"
      stroke="var(--plata-oscura)"
      stroke-width="2.4"
      stroke-linejoin="round"
    />
    <g stroke="var(--plata-oscura)" stroke-width="2.4" stroke-linecap="round" opacity=".85">
      {lineas.map(([p, q]) => <line x1={p.x} y1={p.y} x2={q.x} y2={q.y} />)}
    </g>
  </svg>
</div>

<style>
  #pintadera {
    position: fixed;
    top: 0;
    left: 0;
    width: 16px;
    height: 14px;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    /* El centro del sello va donde va el puntero. */
    transform: translate3d(-100px, -100px, 0) translate(-50%, -50%);
    transition: opacity 0.25s ease, width 0.2s ease, height 0.2s ease;
    filter: drop-shadow(0 2px 6px rgba(11, 18, 48, 0.35));
  }
  :global(html.pintadera-viva) #pintadera {
    opacity: 1;
  }
  /* Sobre algo en lo que se puede pulsar, el sello crece: es la única señal de
     que ahí hay algo, ahora que no está la manita del sistema. */
  :global(html.pintadera-viva.sobre-activo) #pintadera {
    width: 24px;
    height: 21px;
  }
  #pintadera svg {
    width: 100%;
    height: 100%;
    display: block;
    transform: rotate(var(--giro, 0deg));
  }
  /* Quieto un rato: el sello se coloca girando sobre sí mismo. */
  :global(html.pintadera-girando) #pintadera svg {
    animation: girar 4.5s linear infinite;
  }
  @keyframes girar {
    to {
      transform: rotate(360deg);
    }
  }

  /* El cursor del sistema se retira solo cuando el sello ya está en pantalla. */
  :global(html.pintadera-viva),
  :global(html.pintadera-viva *) {
    cursor: none;
  }
  /* Menos en los campos de texto: ahí la barra dice dónde vas a escribir. */
  :global(html.pintadera-viva input),
  :global(html.pintadera-viva textarea),
  :global(html.pintadera-viva select) {
    cursor: auto;
  }
</style>

<script>
  const sello = document.getElementById("pintadera");
  const raiz = document.documentElement;
  const finoYQuieto =
    matchMedia("(pointer: fine)").matches &&
    !matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (sello && finoYQuieto) {
    const destino = { x: -100, y: -100 };
    const actual = { x: -100, y: -100 };
    let visto = false;
    let quieto: number | undefined;

    const despertar = () => {
      raiz.classList.remove("pintadera-girando");
      clearTimeout(quieto);
      // 1,6 s: bastante para no dispararse entre dos gestos, poco para que se
      // note cuando de verdad has soltado el ratón.
      quieto = window.setTimeout(() => raiz.classList.add("pintadera-girando"), 1600);
    };

    addEventListener(
      "pointermove",
      (e) => {
        if (e.pointerType !== "mouse") return;
        destino.x = e.clientX;
        destino.y = e.clientY;
        if (!visto) {
          // Sin saltos: la primera vez aparece donde está el ratón, no viajando
          // desde la esquina.
          actual.x = destino.x;
          actual.y = destino.y;
          visto = true;
          raiz.classList.add("pintadera-viva");
        }
        despertar();

        /*
          ¿Hay algo pulsable debajo? Se pregunta al DOM, no se mantiene una
          lista de selectores por elemento: así vale para los enlaces que
          aparezcan mañana sin tocar esto.
        */
        const bajo = e.target as Element | null;
        const activo = !!bajo?.closest?.("a, button, [role='button'], summary, label");
        raiz.classList.toggle("sobre-activo", activo);
      },
      { passive: true }
    );

    // Al salir de la ventana el sello se va con él.
    addEventListener("pointerout", (e) => {
      if (!e.relatedTarget) raiz.classList.remove("pintadera-viva");
    });
    addEventListener("pointerover", () => {
      if (visto) raiz.classList.add("pintadera-viva");
    });

    const bucle = () => {
      // Persigue con retardo: un sello que va clavado al puntero se lee como
      // parte del sistema, no como un objeto.
      /*
        0,45: persigue casi clavada. Con 0,22 el sello iba visiblemente por
        detrás del puntero y eso, en un cursor, no se lee como peso, se lee
        como retraso: cuesta apuntar. El poco retardo que queda es el que le
        da cuerpo de objeto.
      */
      actual.x += (destino.x - actual.x) * 0.45;
      actual.y += (destino.y - actual.y) * 0.45;
      sello.style.transform = `translate3d(${actual.x}px, ${actual.y}px, 0) translate(-50%, -50%)`;
      requestAnimationFrame(bucle);
    };
    requestAnimationFrame(bucle);
  }
</script>
