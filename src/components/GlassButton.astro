---
/*
  Llamada a la acción, estilo único de todo el sitio (2026-08-05).

  Antes esto era una píldora de cristal con contorno y sombra, y convivía con un
  segundo estilo de enlace subrayado. En la misma pantalla de la home se veían
  los dos y no había forma de saber cuál mandaba. Se queda el segundo: sin caja,
  sin contorno, solo el texto con su filete debajo. Encaja además con la
  contención del manual mejor que la píldora.

  El color se hereda del campo (ver tokens.css): plata clara sobre azul y navy,
  azul Atis sobre los campos claros. El componente no necesita saber dónde está.

  `withDot` sigue en la interfaz aunque ya no pinte nada: lo pasan varias
  páginas y no compensa tocarlas todas para quitar algo inofensivo.
*/
interface Props {
  href?: string;
  type?: "button" | "submit";
  withDot?: boolean;
}
const { href, type = "button" } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag class="cta" href={href} type={href ? undefined : type}>
  <slot />
</Tag>

<style>
  .cta {
    display: inline-block;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: 0;
    padding: 0 0 3px;
    color: var(--azul);
    border-bottom: 1px solid rgba(51, 75, 164, 0.4);
    transition:
      border-color 0.25s ease,
      color 0.25s ease;
  }
  .cta:hover {
    border-bottom-color: var(--azul);
  }
  .cta:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>
