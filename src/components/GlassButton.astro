---
interface Props {
  href?: string;
  type?: "button" | "submit";
  withDot?: boolean;
}
const { href, type = "button", withDot = true } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag class="glass" href={href} type={href ? undefined : type}>
  {withDot && <span class="dot"></span>}
  <slot />
</Tag>

<style>
  .glass {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border-radius: 14px;
    padding: 12px 22px;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    border: 0;
    color: var(--azul-deep);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    background: rgba(51, 75, 164, 0.12);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 16px 34px -12px rgba(51, 75, 164, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.9),
      inset 0 -10px 20px -14px rgba(51, 75, 164, 0.4);
  }
  .glass:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 44px -12px rgba(51, 75, 164, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }
  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: linear-gradient(135deg, #eef1f7, #9aa0ab);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.6);
    flex: none;
  }
</style>
