---
interface Props {
  kicker: string;
  title: string;
}
const { kicker, title } = Astro.props;
---

<section class="page-hero">
  <div class="kick">{kicker}</div>
  <h1>{title}</h1>
  <slot />
</section>

<style>
  .page-hero {
    max-width: 760px;
    margin: 0 auto;
    padding: 44px 24px 20px;
    text-align: center;
  }
  .kick {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--azul);
    font-weight: 700;
    margin-bottom: 16px;
  }
  h1 {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-wrap: balance;
    margin: 0;
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
  }
</style>
