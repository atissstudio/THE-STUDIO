---
interface Card {
  sector: string;
  text: string;
  source: string;
}
interface Props {
  cards: Card[];
}
const { cards } = Astro.props;
---

<div class="carousel" data-carousel>
  <div class="track" data-track>
    {
      cards.map((card, i) => (
        <article class="card" data-source={card.source} aria-hidden={i === 0 ? "false" : "true"}>
          <span class="sector">{card.sector}</span>
          <p>{card.text}</p>
        </article>
      ))
    }
  </div>
  <div class="dots" role="tablist" aria-label="Casos por sector">
    {
      cards.map((_, i) => (
        <button
          type="button"
          role="tab"
          aria-selected={i === 0 ? "true" : "false"}
          aria-label={`Ver tarjeta ${i + 1} de ${cards.length}`}
          data-dot={i}
        />
      ))
    }
  </div>
</div>

<style>
  .carousel {
    max-width: 560px;
    margin: 0 auto;
  }
  .track {
    position: relative;
    min-height: 190px;
  }
  .card {
    position: absolute;
    inset: 0;
    background: var(--panel);
    border: 1px solid rgba(51, 75, 164, 0.12);
    border-radius: var(--radius-lg);
    padding: 28px 26px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease;
  }
  .card.is-active {
    opacity: 1;
    visibility: visible;
    position: relative;
  }
  .sector {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--azul);
    margin-bottom: 10px;
  }
  .card p {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.6;
    color: var(--ink);
    text-align: justify;
    text-align-last: left;
  }
  .dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
  }
  .dots button {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    padding: 0;
    background: var(--line);
    cursor: pointer;
  }
  .dots button[aria-selected="true"] {
    background: var(--azul);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>("[data-track]");
    const cards = Array.from(track?.querySelectorAll<HTMLElement>(".card") ?? []);
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>("[data-dot]"));
    let active = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (index: number) => {
      cards.forEach((card, i) => {
        card.classList.toggle("is-active", i === index);
        card.setAttribute("aria-hidden", i === index ? "false" : "true");
      });
      dots.forEach((dot, i) => dot.setAttribute("aria-selected", i === index ? "true" : "false"));
      active = index;
    };

    const next = () => show((active + 1) % cards.length);

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    show(0);
    if (!reduceMotion && cards.length > 1) {
      timer = setInterval(next, 6000);
    }

    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => {
        show(i);
        if (timer) {
          clearInterval(timer);
          timer = reduceMotion ? undefined : setInterval(next, 6000);
        }
      });
    });
  });
</script>
