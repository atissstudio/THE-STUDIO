---
/*
  ══ LAS ESCENAS DEL PAISAJE ══════════════════════════════════════════════════

  Cuatro tramos del paisaje canario, dibujados como GEOMETRÍA PLANA: risco, mar,
  playa y pueblo.

  ⚠️ POR QUÉ MINIMALISTAS, Y NO UN RENDER. Se intentó dos veces un paisaje
  realista escrito a mano en un shader y las dos salió trabajo de aficionado:
  la profundidad no se pinta, se tiene, y fingirla con ruido no funciona. El
  minimalismo no es un premio de consolación, es la salida buena: con formas
  planas y bien cortadas no hay nada que fingir, así que no hay nada que salga
  mal. Y encaja con el sistema v5, que ya es campos de color planos y esquinas
  en pico.

  Cómo se consigue la profundidad sin renderizar nada: TRES PLANOS por escena
  (fondo, medio, frente) que se mueven a distinta velocidad con el scroll. Eso
  es paralaje, y es profundidad de verdad —posiciones distintas moviéndose a
  ritmos distintos—, no un dibujo que la imita.

  Reglas que respeta:
    · Solo `transform` y `opacity`, nada que recalcule la maquetación.
    · Con "menos movimiento" los planos se quedan quietos, y la escena sigue
      siendo una composición válida. Nunca queda vacía.
    · Colores del catálogo de materiales aprobado, sin inventar ninguno.
*/
interface Props {
  tipo: "risco" | "mar" | "playa" | "pueblo";
  /** Rótulo del tramo. Si no se pasa, no se pinta. */
  nombre?: string;
  /**
   * Modo PIE: la escena no trae fondo propio y se apoya en el borde de abajo
   * de la sección anterior, como su remate. Sin esto, el cielo de la escena es
   * un rectángulo de color distinto al del campo que tiene encima y se ve la
   * costura, que es justo lo que había que quitar.
   */
  pie?: boolean;
  /**
   * De qué campo cuelga la escena, para que el aire de encima de las cumbres
   * sea EXACTAMENTE ese color y no se vea ninguna franja.
   *
   * ⚠️ Sin esto, en modo pie la escena deja ver el fondo de la página
   * (`--blanco`, #F7F9FC) mientras la sección de la que cuelga es `--claro`
   * (#EEF1F7): dos claros parecidos pegados, y entre ellos una franja que se
   * ve. El dibujo tiene que comportarse como un PNG recortado SOBRE su campo,
   * no sobre el papel de la página.
   */
  campo?: "claro" | "blanco" | "azul";
}
const { tipo, nombre, pie = false, campo = "blanco" } = Astro.props;

/*
  ⚠️ CADA ESCENA TIENE SU ENCUADRE EN MODO PIE. El dibujo se hizo para un cuadro
  cuadrado-ish (1200x520) y la franja de pie es mucho más ancha que alta, así
  que al ajustarse se aplasta. La solución no es estirar menos, es MIRAR SOLO LA
  PARTE QUE INTERESA: en el pueblo, la banda donde están las casas; en el risco,
  desde las cumbres hacia abajo. Así lo que llena la franja es el motivo, no el
  aire que tiene encima, y las casas vuelven a ser casas en vez de lonchas.
*/
const encuadre: Record<string, string> = {
  risco: "0 88 1200 432",
  pueblo: "0 296 1200 224",
  mar: "0 0 1200 520",
  playa: "0 0 1200 520",
};
const caja = pie ? encuadre[tipo] : "0 0 1200 520";
---

<div class:list={["escena", `e-${tipo}`, `c-${campo}`, { pie }]} data-escena aria-hidden="true">
  <svg viewBox={caja} preserveAspectRatio={pie ? "none" : "xMidYMid slice"} role="presentation" data-pie={pie ? "" : null}>
    {
      tipo === "risco" && (
        <>
          {/* Cielo: una sola banda, sin degradado. */}
          {!pie && <rect x="0" y="0" width="1200" height="520" fill="var(--cielo)" />}
          {/* Fondo: la cordillera lejana, un solo tono lavado. */}
          <g data-plano="fondo">
            <path d="M-200 344 L0 330 L210 196 L330 268 L520 132 L700 250 L880 168 L1060 262 L1200 214 L1400 236 L1400 520 L-200 520 Z" fill="var(--roca-lejos)" />
          </g>
          {/* Medio: el macizo que manda, con su cumbre. */}
          <g data-plano="medio">
            <path d="M-200 438 L0 420 L180 300 L300 356 L470 190 L640 330 L760 286 L900 380 L1060 320 L1200 386 L1400 404 L1400 520 L-200 520 Z" fill="var(--roca-medio)" />
            {/* Dos coladas: el estrato como línea, no como textura. */}
            <path d="M470 190 L640 330 L760 286 L900 380 L1060 320 L1200 386 L1400 404" fill="none" stroke="var(--cal)" stroke-opacity=".18" stroke-width="2" />
          </g>
          {/* Frente: el pie del acantilado, casi negro. */}
          <g data-plano="frente">
            <path d="M-200 498 L0 486 L150 430 L340 470 L560 412 L780 462 L1000 424 L1200 468 L1400 480 L1400 520 L-200 520 Z" fill="var(--roca-cerca)" />
          </g>
        </>
      )
    }
    {
      tipo === "mar" && (
        <>
          <rect x="0" y="0" width="1200" height="520" fill="var(--agua-honda)" />
          {/* El oleaje son LÍNEAS, que es como se dibuja el mar cuando se
              dibuja poco: más juntas arriba (lejos) y más abiertas abajo. */}
          <g data-plano="fondo" stroke="var(--cal)" stroke-opacity=".22" fill="none" stroke-linecap="round">
            {[60, 88, 120, 156].map((y, i) => (
              <path d={`M-40 ${y} q 90 -9 180 0 t 180 0 t 180 0 t 180 0 t 180 0 t 180 0`} stroke-width={1 + i * 0.2} />
            ))}
          </g>
          <g data-plano="medio" stroke="var(--cal)" stroke-opacity=".3" fill="none" stroke-linecap="round">
            {[204, 258, 320].map((y, i) => (
              <path d={`M-60 ${y} q 120 -15 240 0 t 240 0 t 240 0 t 240 0 t 240 0`} stroke-width={1.6 + i * 0.5} />
            ))}
          </g>
          <g data-plano="frente" stroke="var(--cal)" stroke-opacity=".42" fill="none" stroke-linecap="round">
            {[392, 470].map((y, i) => (
              <path d={`M-80 ${y} q 160 -24 320 0 t 320 0 t 320 0 t 320 0`} stroke-width={2.6 + i} />
            ))}
          </g>
        </>
      )
    }
    {
      tipo === "playa" && (
        <>
          <rect x="0" y="0" width="1200" height="520" fill="var(--agua-orilla)" />
          {/* La orilla es UN ARCO, y es lo único que hace falta para que se
              lea como playa: agua arriba, arena abajo, y la línea entre las
              dos con su espuma. */}
          <g data-plano="fondo">
            <path d="M0 236 Q 300 194 620 232 T 1200 210 L1200 0 L0 0 Z" fill="var(--agua-honda)" />
          </g>
          <g data-plano="medio">
            <path d="M0 318 Q 320 268 660 316 T 1200 292 L1200 520 L0 520 Z" fill="var(--arena)" />
            <path d="M0 318 Q 320 268 660 316 T 1200 292" fill="none" stroke="var(--cal)" stroke-width="5" stroke-linecap="round" />
          </g>
          {/* Frente: la arena seca, y tres cantos. Nada más. */}
          <g data-plano="frente">
            <path d="M0 424 Q 340 386 700 424 T 1200 404 L1200 520 L0 520 Z" fill="var(--picon)" />
            <circle cx="214" cy="470" r="11" fill="var(--roca-cerca)" />
            <circle cx="268" cy="482" r="7" fill="var(--roca-cerca)" />
            <circle cx="906" cy="466" r="9" fill="var(--roca-cerca)" />
          </g>
        </>
      )
    }
    {
      tipo === "pueblo" && (
        <>
          {!pie && <rect x="0" y="0" width="1200" height="520" fill="var(--cielo)" />}
          {/*
            EL CASERÍO. Sigue siendo geometría plana, pero con lo que hace que
            una casa canaria se reconozca: cornisa azul de barca, cenefa de
            rombos en la tapia, friso de triángulos, chimenea de bloque y una
            palmera. Son los mismos motivos del diorama de Alejandro, reducidos
            a lo mínimo que aún los identifica.
          */}
          <g data-plano="fondo" fill="var(--roca-lejos)" opacity={pie ? 0.4 : 1}>
            <rect x="60" y="300" width="150" height="90" />
            <rect x="250" y="286" width="120" height="104" />
            <rect x="470" y="308" width="180" height="82" />
            <rect x="760" y="292" width="140" height="98" />
            <rect x="980" y="312" width="160" height="78" />
          </g>
          <g data-plano="medio">
            {/*
              LA PALMERA, CON SU COLOR (2026-08-21, pedido de Alejandro: "de los
              colores típicos canarios"). Iba en gris de roca, como el resto de
              la geometría, y en un pueblo encalado la palmera es justo lo que
              pone el color. Tronco en barro y fronda en verde palmera, dos
              hojas más para que se lea como copa y no como aspa.

              ⚠️ Los dos colores son NUEVOS: no están en el catálogo de doce
              materiales canarios, que no tiene ningún verde. Queda anotado para
              el Brandbook.
            */}
            <g fill="var(--tronco)">
              <rect x="72" y="368" width="9" height="104" />
            </g>
            <g fill="var(--palma)">
              <path d="M76 366 L26 350 L34 372 Z" />
              <path d="M76 366 L126 348 L120 371 Z" />
              <path d="M76 364 L48 330 L70 340 Z" />
              <path d="M76 364 L106 332 L86 341 Z" />
              <path d="M76 364 L76 326 L86 344 Z" />
              <path d="M76 366 L36 372 L48 382 Z" />
              <path d="M76 366 L116 372 L104 382 Z" />
            </g>
            <g fill="var(--cal)">
              <rect x="120" y="352" width="190" height="120" />
              <rect x="352" y="330" width="150" height="142" />
              <rect x="546" y="366" width="230" height="106" />
              <rect x="820" y="342" width="170" height="130" />
              <rect x="1020" y="372" width="140" height="100" />
            </g>
            {/* Chimeneas: dos, no cinco. Lo que se repite deja de leerse. */}
            <g fill="var(--cal)">
              <rect x="286" y="336" width="18" height="18" />
              <rect x="944" y="326" width="18" height="18" />
            </g>
            <g fill="var(--azul)">
              {/* Cornisa: la franja azul bajo el remate, en todas. */}
              <rect x="120" y="352" width="190" height="9" />
              <rect x="352" y="330" width="150" height="9" />
              <rect x="546" y="366" width="230" height="9" />
              <rect x="820" y="342" width="170" height="9" />
              <rect x="1020" y="372" width="140" height="9" />
              {/* Puertas y ventanas. Una puerta por casa, ventanas de a pares. */}
              <rect x="404" y="404" width="34" height="68" />
              <rect x="196" y="422" width="30" height="50" />
              <rect x="640" y="424" width="30" height="48" />
              <rect x="884" y="410" width="32" height="62" />
              <rect x="150" y="382" width="24" height="24" />
              <rect x="252" y="382" width="24" height="24" />
              <rect x="372" y="360" width="22" height="22" />
              <rect x="458" y="360" width="22" height="22" />
              <rect x="576" y="392" width="22" height="22" />
              <rect x="716" y="392" width="22" height="22" />
              <rect x="840" y="372" width="22" height="22" />
              <rect x="948" y="372" width="22" height="22" />
              <rect x="1044" y="400" width="22" height="22" />
              <rect x="1112" y="400" width="22" height="22" />
            </g>
            {/* Friso de triángulos sobre la casa central: el motivo del diorama. */}
            <g fill="var(--azul)" opacity=".9">
              {[0, 1, 2, 3, 4].map((k) => (
                <path d={`M${368 + k * 26} 350 L${380 + k * 26} 338 L${392 + k * 26} 350 Z`} />
              ))}
            </g>
            {/* El rombo, en la fachada más ancha. */}
            <path d="M661 392 L681 406 L661 420 L641 406 Z" fill="none" stroke="var(--azul)" stroke-width="5" />
          </g>
          <g data-plano="frente">
            {/* La tapia baja, con su cenefa de rombos. */}
            <rect x="-200" y="440" width="1600" height="32" fill="var(--cal)" />
            <g fill="var(--azul)">
              {Array.from({ length: 34 }, (_, k) => (
                <path d={`M${-180 + k * 44} 456 L${-166 + k * 44} 448 L${-152 + k * 44} 456 L${-166 + k * 44} 464 Z`} />
              ))}
            </g>
            {/*
              ⚠️ EL MUELLE VA EN PIEDRA, NO EN NEGRO. En picón se leía como una
              raya negra cortando la escena; en piedra es lo que es, el murete
              del puerto, y encaja con la roca de la sección que viene debajo.
            */}
            <rect x="-200" y="472" width="1600" height="48" fill="var(--roca-medio)" />
            <rect x="-200" y="472" width="1600" height="5" fill="var(--roca-cerca)" />
          </g>
        </>
      )
    }
  </svg>
  {nombre && <span class="escena-nombre">{nombre}</span>}
</div>

<style>
  .escena {
    position: relative;
    height: clamp(300px, 52svh, 520px);
    overflow: hidden;
    /* Materiales del catálogo aprobado. No se inventa ninguno aquí. */
    --cielo: #dfe5f0;
    --roca-lejos: #9aa3b4;
    --roca-medio: #565e6c;
    --roca-cerca: #3b3f45;
    --agua-honda: #22376f;
    --agua-orilla: #6e8ad0;
    --arena: #38352f;
    /*
      ⚠️ DOS COLORES QUE NO ESTÁN EN EL CATÁLOGO DE MATERIALES (2026-08-21). El
      catálogo de doce materiales canarios no tiene ningún verde, y una palmera
      gris no es una palmera. Verde de palmera canaria (la fronda seca tira a
      oliva, no al verde hierba) y barro para el tronco, que es el mismo
      registro que la teja. Van anotados para el Brandbook.
    */
    --palma: #4f6b3c;
    --tronco: #7c5a3f;
    /*
      El alto de la banda en móvil. Vive aquí y lo lee también el tramo que
      tiene que reservarle el hueco (`.deja-remate` en tokens.css): un solo
      número para las dos mitades del trato, o vuelven a descuadrarse.
    */
    --remate: 172px;
  }
  /*
    ⚠️ EN MODO PIE NO HAY FONDO NINGUNO. La escena se apoya en lo que tenga
    encima, así que el campo de la sección sigue de largo hasta las cumbres y
    no aparece ningún rectángulo de otro color. Es lo que pidió Alejandro al
    ver el gris del cielo cortando contra el claro de la sección.
  */
  .escena.pie {
    background: var(--blanco);
  }
  .escena.pie.c-claro {
    background: var(--plata-clara);
  }
  .escena.pie.c-azul {
    background: var(--azul);
  }
  .escena.pie {
    /*
      ⚠️ ALTO SUFICIENTE, O EL DIBUJO SE APLASTA. En modo pie el SVG se ajusta a
      la caja sin recortar (si recortara, se comería las cumbres), así que la
      caja tiene que guardar una proporción parecida a la del dibujo. Con 262 px
      sobre 1280 de ancho la compresión era del doble y las casas salían como
      lonchas. Con este alto la deformación es leve y las montañas y el caserío
      se leen bien los dos.
    */
    height: clamp(300px, 54svh, 560px);
    margin-top: calc(var(--row) * -0.35);
    /* Pegada a lo que venga debajo: si es agua, el pueblo queda a pie de
       muelle. Un hueco aquí rompe el puerto. */
    margin-bottom: 0;
    display: block;
  }

  /*
    ⚠️ EL RISCO SE HUNDE EN LO QUE VIENE DEBAJO (2026-08-21). El mar le monta
    encima al pie de la montaña y ella asoma por detrás. Es profundidad de
    verdad —un objeto delante de otro—, no un degradado que la insinúe, y es lo
    que separa un recorte pegado de un paisaje con fondo.

    Se hace con margen negativo, no bajando la montaña: así el campo de abajo
    no cambia de tamaño ni empuja nada, solo se solapa.
  */
  .escena.e-risco.pie {
    margin-bottom: calc(clamp(56px, 10svh, 118px) * -1);
    /* El campo que viene debajo del risco es la roca de `.05`, el mismo valor
       exacto que la fila de montaña más cercana. Solo se usa en móvil. */
    --suelo: var(--roca-cerca);
  }
  /* Y el pueblo se mete en el agua: el mar sale de debajo del muelle. */
  .escena.e-pueblo.pie {
    margin-bottom: calc(clamp(34px, 6svh, 76px) * -1);
    /* Y debajo del pueblo, el agua del cierre: queda a pie de muelle. */
    --suelo: var(--azul);
  }
  /*
    ⚠️ QUIEN TIENE QUE PINTAR ENCIMA SE MARCA A MANO, no con un selector de
    hermano: Astro mete un <script> justo detrás del componente, así que el
    "siguiente hermano" no es la sección, es esa etiqueta invisible, y el orden
    se le aplicaba a ella. La sección que monta encima lleva `sobre-escena`.
  */
  .escena svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /*
    LA PROFUNDIDAD. Cada plano se desplaza a un ritmo distinto según lo lejos
    que esté: el fondo apenas se mueve, el frente se mueve mucho. `--pl` la
    escribe el guion con el avance de la escena por la pantalla, de -1 a 1.
  */
  /*
    ⚠️ CADA FILA VIAJA HACIA UN LADO (2026-08-21). Con las tres yendo en el
    mismo sentido y solo a distinta velocidad, el ojo lee UN bloque que se
    desliza. Cruzándolas —el fondo a un lado, el medio al contrario, el frente
    otra vez al primero— lee tres cosas distintas a tres distancias distintas,
    que es lo que se busca. Es el mismo principio que el mar cruzado.
  */
  .escena [data-plano="fondo"] {
    transform: translate3d(calc(var(--pl, 0) * 2%), 0, 0);
  }
  .escena [data-plano="medio"] {
    transform: translate3d(calc(var(--pl, 0) * -4.2%), 0, 0);
  }
  .escena [data-plano="frente"] {
    transform: translate3d(calc(var(--pl, 0) * 8.5%), 0, 0);
  }
  /*
    ⚠️ Los dibujos se salen 200 unidades por cada lado del cuadro. Al
    desplazarse con el paralaje, un dibujo que acabe justo en el borde deja ver
    su canto y aparece una franja vacía en un lado. Sobrando por fuera, no hay
    canto que pueda asomar.
  */
  .escena-nombre {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    color: var(--cal);
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 700;
    text-shadow: 0 1px 14px rgba(11, 18, 48, 0.7);
    white-space: nowrap;
  }
  /*
    ⚠️ MÓVIL: PANTALLA ENTERA. La regla vive AQUÍ y no en tokens.css porque los
    estilos con ámbito de Astro añaden un atributo al selector, así que una
    regla suelta de la hoja compartida pierde por especificidad y no aplicaba.
    Medían 456 px sobre 844: parar ahí era quedarse a media página.
  */
  /*
    ══ MÓVIL: LA ESCENA REMATA EL TRAMO DE ARRIBA, CON SITIO RESERVADO ═══════

    Tercera versión del mismo asunto, y las dos anteriores fallaron por lo
    mismo pero al revés:

      · Remate con margen negativo (mañana): se subía sobre el tramo anterior
        SIN que ese tramo le hiciera sitio, y le tapaba el texto.
      · Pantalla propia (mediodía): no tapaba nada, pero se llevaba una
        pantalla entera con el dibujo abajo y dos tercios de aire.

    Lo que faltaba en la primera no era quitarle el solape, era **reservar el
    hueco**: el tramo de arriba se queda con `--remate` menos de alto útil y la
    escena se sube exactamente eso. Así remata el tramo, como pidió Alejandro,
    sin robarle una línea de texto y sin gastar una pantalla.

    ⚠️ Quien reserva es la sección de arriba, y se marca A MANO con la clase
    `deja-remate` (no vale un selector de hermano: Astro mete un <script> justo
    detrás del componente).
  */
  @media (max-width: 900px) {
    .escena.pie,
    .escena.e-risco.pie,
    .escena.e-pueblo.pie {
      height: var(--remate);
      margin-top: calc(var(--remate) * -1);
      margin-bottom: 0;
      position: relative;
      z-index: 2;
      pointer-events: none;
      /* Sin fondo propio: se apoya en el campo del tramo que remata. */
      background: transparent;
    }
    /*
      El dibujo, entero de lado a lado y apoyado abajo. `meet` y no `slice`:
      con `slice` un dibujo panorámico en un teléfono enseña menos de la mitad
      del ancho y se lee como dos casas gigantes.
    */
    .escena.pie svg {
      position: absolute;
      left: 0;
      right: 0;
      top: auto;
      bottom: 0;
      height: 100%;
    }
    .escena.pie .escena-nombre {
      display: none;
    }
  }

  /* Con menos movimiento los planos se quedan quietos. La escena sigue siendo
     una composición completa: no depende del paralaje para tener sentido. */
  @media (prefers-reduced-motion: reduce) {
    .escena [data-plano] {
      transform: none !important;
    }
  }
</style>

<script>
  /*
    ⚠️ `preserveAspectRatio` NO ES UNA PROPIEDAD CSS: es un atributo del SVG, así
    que no se puede cambiar con una consulta de medios. Se cambia aquí, y se
    vuelve a mirar al girar el teléfono.

    ⚠️ Y EN MÓVIL ES `meet`, NO `slice` (corregido el 2026-08-21). Con `slice`
    el dibujo escala hasta CUBRIR la banda, y como el dibujo es panorámico
    (1200x520) y el teléfono estrecho, se veía menos de la mitad del ancho: dos
    casas gigantes cortadas por los lados en vez de un caserío. Con `meet` cabe
    entero de lado a lado, apoyado en el borde de abajo (`YMax`), y lo que
    sobra de banda por arriba es cielo, o sea el color del campo. Ni se
    deforma (eso lo evitan los dos) ni se amplía.
  */
  const ajustarProporcion = () => {
    const movil = matchMedia("(max-width: 900px)").matches;
    for (const svg of document.querySelectorAll<SVGSVGElement>(".escena.pie svg")) {
      svg.setAttribute("preserveAspectRatio", movil ? "xMidYMax meet" : "none");
    }
  };
  ajustarProporcion();
  addEventListener("resize", ajustarProporcion);

  /*
    Un solo observador para todas las escenas, y el cálculo dentro del bucle de
    fotogramas: leer la posición en cada evento de scroll obliga al navegador a
    recalcular y da tirones. Solo se tocan `transform`, nunca la maquetación.
  */
  const escenas = [...document.querySelectorAll<HTMLElement>("[data-escena]")];
  if (escenas.length) {
    const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const visibles = new Set<HTMLElement>();

    const ojo = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) visibles.add(e.target as HTMLElement);
          else visibles.delete(e.target as HTMLElement);
        }
      },
      { rootMargin: "20% 0px" }
    );
    escenas.forEach((e) => ojo.observe(e));

    let pedido = false;
    const colocar = () => {
      pedido = false;
      for (const e of visibles) {
        const caja = e.getBoundingClientRect();
        // -1 cuando la escena entra por abajo, +1 cuando sale por arriba.
        const centro = (caja.top + caja.height / 2 - innerHeight / 2) / (innerHeight / 2 + caja.height / 2);
        e.style.setProperty("--pl", Math.max(-1, Math.min(1, centro)).toFixed(3));
      }
    };
    const pedir = () => {
      if (pedido) return;
      pedido = true;
      requestAnimationFrame(colocar);
    };
    if (!quieto) {
      addEventListener("scroll", pedir, { passive: true });
      addEventListener("resize", pedir);
    }
    colocar();
    // Red de seguridad: si algo fallara, los planos se quedan en su sitio y la
    // escena se ve igual. Nunca queda un hueco vacío.
    setTimeout(colocar, 400);
  }
</script>
