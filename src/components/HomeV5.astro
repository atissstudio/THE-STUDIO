---
/*
  Home v5 — portada de la maqueta aprobada (src/pages/maqueta.astro, ahora retirada)
  con Nav/Footer/SEO reales de BaseLayout y el formulario conectado a /api/lead.
  Ritmo de color: azul (hero) -> plata líquida (.01, la casa) -> claro (.02/.03,
  lectura) -> azul (.04, servicios) -> blanco (.05, datos) -> azul (.06, CTA).
*/
import GlassButton from "./GlassButton.astro";
import { servicios as todos } from "../data/servicios";

// En la home solo entran los tres primeros. El resto vive en /servicios.
const destacados = todos.slice(0, 3);
---

<section class="f-azul hero row12">
  <h1 class="logo-h1">
    <span class="scr">the</span><span class="hvy">STUDIO</span><span class="scr">by</span><span class="hvy">ATIS</span>
    {/* En móvil manda el logo vertical oficial del manual, no una recreación con texto */}
    <img class="logo-img" src="/logo/perfil-blanco.svg" alt="the STUDIO by ATIS" width="252" height="133" />
  </h1>
  {/*
    Banner en marcha. La manuscrita entra aquí como decoración repetida, que es
    el uso que el manual le permite fuera del logo, no como texto de lectura.
    Se duplica exacto para que el bucle no tenga costura.
  */}
  <div class="claim-banner">
    <div class="claim-cinta">
      {
        /*
          Doce repeticiones: seis por mitad. La animación desplaza justo la
          mitad de la cinta, así que cada mitad tiene que ser por sí sola más
          ancha que la pantalla o al reiniciar el bucle asomaría un hueco.
          Seis cubren hasta unos 3.200 px de ancho.
        */
        Array.from({ length: 12 }).map(() => (
          <span>la p*ta primera cooperativa creativa ·&nbsp;</span>
        ))
      }
    </div>
  </div>
</section>

<div class="reel" id="reel">
  <div class="reel-liquid"><i class="l1"></i><i class="l2"></i><i class="l3"></i></div>
  <div class="reel-stage" id="reelStage">
    <div class="reel-kick">El punto de partida · .01</div>
    <div class="reel-phrase reel-p1">Tu negocio ya vale.</div>
    <div class="reel-house" id="reelHouse">
      <img class="r0" src="/negocio/casa-00-dark.webp" alt="Tu negocio, todavía apagado" />
      <img class="r1" src="/negocio/casa-30.webp" alt="" />
      <img class="r2" src="/negocio/casa-70.webp" alt="" />
      <img class="r3" src="/negocio/casa-100-vivid.webp" alt="Tu negocio con su marca activada" />
    </div>
    <div class="reel-phrase reel-p2">Vamos a que se note.</div>
  </div>
</div>

<section class="f-claro field-pad row12" data-reveal data-slides>
  <span class="field-tag" style="color:var(--azul)">.02</span>
  <div class="read">
    <p class="k">Por qué existimos</p>
    <h2>Tu negocio de siempre, con las herramientas de los más grandes.</h2>
    <p>
      Creemos que los negocios locales no deberían quedarse atrás por falta de recursos. Por eso,
      hemos diseñado un sistema que democratiza la estrategia, la inteligencia artificial y la
      comunicación.
    </p>
    <p>
      Nuestro objetivo es que el negocio canario de toda la vida tenga exactamente las mismas
      oportunidades para competir, y ganar, que una gran multinacional.
    </p>
    <p>
      Todo empieza por conocerte. Entendemos tus necesidades y diseñamos un plan integral a tu
      medida. Combinamos tecnología y estrategia para impulsar tu rentabilidad, haciendo que tu
      negocio logre <span class="em on-light">mucho más, por menos</span>.
    </p>
    <p class="read-cta">
      <GlassButton href="/contacto">Quiero que me ayudéis a crecer</GlassButton>
    </p>
    {/*
      El texto dice que el negocio canario tenga LAS MISMAS oportunidades que
      una multinacional. Las islas entran desiguales —a distintas alturas y
      tamaños— y se nivelan contra una misma línea. No es decoración: es la
      frase, dicha con el elemento gráfico de la marca.
    */}
    <div class="slide-art art-islas" data-art aria-hidden="true">
      {["08", "06", "07", "05", "01", "02", "03", "04"].map((n, i) => (
        <img class="isla-nivel" src={`/plata/isla-${n}.webp`} alt="" style={`--i:${i}`} />
      ))}
    </div>
  </div>
</section>

<section class="f-claro row12" style="padding-top:0; padding-bottom: calc(var(--row)*.45)" data-reveal data-slides>
  <span class="field-tag" style="color:var(--azul)">.03</span>
  <div class="read right">
    <p class="k">Cómo lo hacemos</p>
    <h2>Un proceso, sin humo.</h2>
    <p><span class="em on-light">Te auditamos.</span> No como un examen, sino como quien te escucha antes de opinar. Miramos tu negocio con datos y entendemos qué necesitas, quién eres y qué te frena.</p>
    <p><span class="em on-light">Lo diseñamos contigo.</span> No una plantilla genérica. Un plan hecho a la medida de tu negocio, de tu gente y de tu momento.</p>
    <p><span class="em on-light">Lo implementamos de la mano.</span> Sin dejarte solo con la tecnología. Te explicamos cada paso mientras lo hacemos.</p>
    <p class="read-cta">
      <GlassButton href="/como-trabajamos">Ver el método completo, paso a paso</GlassButton>
    </p>
    {/*
      Tres pasos, un camino. La línea se dibuja hacia abajo y cada nudo se
      enciende al llegar. Es el filete de 1 px del manual, puesto a contar el
      proceso en vez de solo separar.
    */}
    <div class="slide-art art-proceso" data-art aria-hidden="true">
      <svg viewBox="0 0 120 420" fill="none" preserveAspectRatio="xMidYMid meet">
        <path class="pr-linea" d="M60 24 L60 396" stroke-width="2" stroke-linecap="round" />
        <circle class="pr-nudo" cx="60" cy="86" r="9" stroke-width="2" />
        <circle class="pr-nudo" cx="60" cy="210" r="9" stroke-width="2" />
        <circle class="pr-nudo" cx="60" cy="334" r="9" stroke-width="2" />
      </svg>
    </div>
  </div>
</section>

<section class="f-azul row12 field-cards">
  <span class="field-tag">.04</span>
  <div class="cells">
    <div class="head-cell">
      <p class="k">Qué hacemos</p>
      <h2>Servicios.</h2>
      <a class="head-link" href="/servicios">Ver los siete</a>
    </div>
    {destacados.map((s, i) => (
      <a class="cell" href={`/servicios/${s.slug}`}>
        <span class="n">{String(i + 1).padStart(2, "0")}</span>
        <span class="ct">{s.title}</span>
        <span class="cp">{s.card}</span>
        <img class="isla-in" src={s.isla} alt="" loading="lazy" />
      </a>
    ))}
  </div>
</section>

<section class="f-blanco row12 field-cards">
  <span class="field-tag" style="color:var(--azul)">.05</span>
  <div class="datos">
    <div class="head-cell"><p class="k">Los datos</p><h2>No hablamos por hablar.</h2></div>
    <div class="dato">
      <p class="big">80%</p>
      <span class="q">cómo evitar que los pacientes falten a la cita</span>
      <span class="a">Un recordatorio automático por WhatsApp corta los no-shows hasta ese porcentaje.</span>
    </div>
    <div class="dato">
      <p class="big">x21</p>
      <span class="q">pierdo clientes por no responder a tiempo</span>
      <span class="a">Contestar en menos de 5 minutos multiplica por 21 tus opciones de cerrar.</span>
    </div>
    <div class="dato">
      <p class="big">30%</p>
      <span class="q">por qué no aceptan mi presupuesto</span>
      <span class="a">No es el precio, es la confianza. Automatizar el seguimiento sube la aceptación hasta un 30%.</span>
    </div>
  </div>
</section>

<div class="cta-wrap">
  <div class="cta-screen" id="ctaScreen">
    <div class="cta-inner">
      <p class="k2">.06 · Tu plan gratis</p>
      <h2>Vamos a que se note.</h2>
      <p>Déjame tu correo y te mando un plan gratis, hecho para ti. Sin compromiso.</p>
      <form class="ctaform" id="ctaform" action="/api/lead" method="post">
        <div class="ctaform-fila">
          <input
            type="email"
            name="email"
            placeholder="tu@correo.com"
            aria-label="Tu correo"
            required
          />
          <GlassButton type="submit" withDot={false}>Pídeme mi plan</GlassButton>
        </div>
        <textarea
          class="ctaform-msg"
          name="message"
          rows="2"
          placeholder="Cuéntanos qué necesitas (opcional)"
          aria-label="Cuéntanos qué necesitas"
        ></textarea>
      </form>
    </div>
  </div>
</div>

<style>
  /*
    Portada: el logo pegado arriba y a sangre, una línea que lo separa, y
    debajo el carril con la frase corriendo. Antes el conjunto iba centrado en
    vertical y el logo quedaba flotando en mitad del campo.
  */
  /*
    La portada mide lo que miden el logo y el carril, no una pantalla entera.
    Con `min-height: 100svh` y el contenido arriba quedaban casi dos tercios de
    campo azul vacío debajo del carril antes de que empezara la casa.
  */
  .hero {
    padding: 0;
    overflow: hidden;
    align-content: start;
  }
  .logo-h1 {
    grid-column: 1/13;
    margin: 0;
    /* Casi sin margen: el wordmark manda y llega al borde */
    padding: calc(var(--menu-h) * 0.6) 12px 0;
    line-height: 0.86;
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.06em;
    font-weight: 400;
    white-space: nowrap;
    color: var(--plata-clara);
  }
  /*
    Cinta del claim: a sangre, separada por dos líneas blancas del logo que
    tiene encima y del campo que viene debajo, para que se lea como una franja
    propia y no como un pie del logo.
  */
  .claim-banner {
    grid-column: 1/13;
    margin-top: calc(var(--row) * 0.42);
    overflow: hidden;
    border-top: 1px solid rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.85);
  }
  .claim-cinta {
    display: flex;
    width: max-content;
    animation: desfile 26s linear infinite;
  }
  .claim-cinta span {
    font-family: var(--script);
    font-size: clamp(1.5rem, 3.4vw, 2.6rem);
    line-height: 1.5;
    padding: 10px 0;
    color: var(--plata-clara);
    white-space: nowrap;
  }
  /*
    Corre de IZQUIERDA a DERECHA: parte medio carril desplazada hacia la
    izquierda y avanza hasta cero. Es justo la mitad porque el contenido está
    duplicado, así que al reiniciar el bucle cae en un punto idéntico y no se
    ve la costura.
  */
  @keyframes desfile {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .claim-cinta {
      animation: none;
    }
  }
  .logo-h1 .scr {
    font-family: var(--script);
    font-size: calc(var(--logo, 10vw) * 0.62);
  }
  .logo-h1 .hvy {
    font-family: var(--sans);
    font-weight: 800;
    font-size: var(--logo, 10vw);
    letter-spacing: -0.035em;
  }
  /* Solo móvil: en escritorio manda el wordmark horizontal, ajustado por JS */
  .logo-h1 .logo-img {
    display: none;
  }
  
  
  
  /* .01 REEL: la casa cruza pintándose, la frase se parte, sobre plata líquida */
  /*
    Alto del tramo de scroll de la casa. Bajado de 300vh a 240vh el 2026-08-05:
    la coreografía terminaba al 74% del recorrido y quedaban unos 80vh de
    scroll muerto con todo ya quieto, así que el campo de plata se sentía
    larguísimo y roto. Ahora el reparto de la animación (abajo, en el script)
    llega casi al final del tramo y no sobra desierto.
  */
  /*
    Dos pantallas justas (2026-08-05). Con 240vh el escenario se quedaba
    anclado durante 1,4 pantallas de scroll y se sentían tres gestos largos
    sobre un campo de plata enorme. Con 200vh el tramo es exactamente el alto
    de una pantalla de scroll: entra la casa, cruza y sale, sin desierto.
  */
  .reel {
    height: 200vh;
    position: relative;
    background: var(--plata-mid);
  }
  .reel-liquid {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .reel-liquid i {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
  }
  .reel-liquid .l1 { width: 55vw; height: 70vh; left: -10vw; top: 5vh; background: radial-gradient(circle, #f4f6fa, rgba(244, 246, 250, 0) 66%); animation: lv1 16s ease-in-out infinite; }
  .reel-liquid .l2 { width: 48vw; height: 66vh; right: -8vw; top: 20vh; background: radial-gradient(circle, #7a828f, rgba(122, 130, 143, 0) 62%); animation: lv2 20s ease-in-out infinite; }
  .reel-liquid .l3 { width: 45vw; height: 60vh; left: 30vw; bottom: 0; background: radial-gradient(circle, #eef1f7, rgba(238, 241, 247, 0) 62%); animation: lv3 24s ease-in-out infinite; }
  @keyframes lv1 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(14vw, 4vh) scale(1.2); } }
  @keyframes lv2 { 0%, 100% { transform: translate(0, 0) scale(1.1); } 50% { transform: translate(-12vw, -3vh) scale(0.9); } }
  @keyframes lv3 { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-16vw, 3vh) scale(1.2); } }
  .reel-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  /*
    Ancho y recorrido recortados el 2026-08-05 porque la casa "se dejaba de
    ver" en escritorio. Con los valores anteriores (56vw y ±22vw de recorrido)
    los extremos daban exactamente 0 px de margen en una pantalla de 1180 px y
    28 px en una de 1280 — o sea, en un portátil normal la casa llegaba pegada
    al borde y el overflow:hidden del escenario la cortaba. Con 50vw y ±16vw
    quedan 106 px y 125 px de aire en esas mismas pantallas.
  */
  .reel-house {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(50vw, 620px);
    aspect-ratio: 1370 / 919;
    /* El valor por defecto es el inicio del recorrido, por si el JS aún no ha
       pintado: antes era 26, más lejos todavía que el propio recorrido. */
    transform: translate(calc(-50% + var(--rx, 16) * 1vw), -50%);
  }
  .reel-house img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .reel-house .r1 { opacity: var(--o30, 0); }
  .reel-house .r2 { opacity: var(--o70, 0); }
  .reel-house .r3 { opacity: var(--o100, 0); }
  .reel-phrase {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40vw;
    padding: 0 20px;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 3vw;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .reel-p1 { left: 3vw; opacity: var(--p1, 1); }
  .reel-p2 { right: 3vw; text-align: right; opacity: var(--p2, 0); }
  .reel-kick {
    position: absolute;
    top: calc(50% - 5vw);
    left: 3vw;
    padding: 0 20px;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--azul);
    opacity: var(--p1, 1);
  }

  /*
    .06 CTA a pantalla completa (rehecho 2026-08-06).

    Antes esto ocupaba DOS pantallas: el contenedor medía una y la CTA, pegada
    dentro, arrancaba recortada del todo (`clip-path: inset(100% …)`) y solo se
    destapaba cuando ya tenía un 35% en pantalla. Como el contenedor no lleva
    fondo, lo que se veía mientras tanto era una pantalla entera de campo claro
    vacío justo antes de la CTA. No aportaba nada y se notaba en cada visita.

    Ahora la CTA ocupa su pantalla y ya está: la entrada la hace su contenido,
    que sube y aparece. `svh` y no `vh` porque en Safari de iOS `vh` mide la
    ventana grande y el campo se salía por abajo (ver CLAUDE.md §6).
  */
  .cta-wrap {
    position: relative;
  }
  .cta-screen {
    min-height: 100svh;
    display: grid;
    place-items: center;
    text-align: center;
    background: var(--azul);
    color: var(--plata-clara);
  }
  .cta-inner {
    max-width: 640px;
    padding: 0 24px;
    transform: translateY(var(--cta-y, 40px));
    opacity: var(--cta-o, 0);
    transition: transform 1s 0.2s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 1s 0.2s ease;
  }
  .cta-screen.in .cta-inner {
    --cta-y: 0px;
    --cta-o: 1;
  }
  .cta-inner .k2 {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #c9d3f5;
    margin: 0 0 20px;
  }
  .cta-inner h2 {
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 20px;
  }
  .cta-inner p {
    color: rgba(238, 241, 247, 0.78);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 auto 28px;
    max-width: 42ch;
  }
  .ctaform {
    display: flex;
    flex-direction: column;
    max-width: 520px;
    margin: 0 auto;
    gap: 12px;
  }
  .ctaform-fila {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }
  .ctaform input {
    flex: 1 1 auto;
    min-width: 0; /* sin esto el input no encoge y empuja al botón */
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.96);
    padding: 16px;
    font-family: var(--sans);
    font-size: 0.95rem;
    color: var(--ink);
  }
  /* La CTA ya no es una píldora, así que solo hay que evitar que se encoja */
  .ctaform :global(.cta) {
    flex: 0 0 auto;
    white-space: nowrap;
  }
  /*
    Campo de "qué necesitas": visible por defecto (si el JS no llega a
    ejecutarse, sigue siendo un campo normal y usable). El script lo colapsa
    al cargar y lo abre en cuanto tocas el correo, para no abrumar de entrada.
  */
  .ctaform-msg {
    width: 100%;
    resize: none;
    box-sizing: border-box;
    max-height: 120px;
    opacity: 1;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.96);
    padding: 14px 16px;
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--ink);
    transition: max-height 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), opacity 0.3s ease,
      padding 0.4s ease, border-width 0.3s ease;
  }
  .ctaform.compacto .ctaform-msg {
    max-height: 0;
    opacity: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-width: 0;
  }

  .read-cta {
    margin-top: 28px;
  }
  .head-link {
    margin-top: 18px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #c9d3f5;
    text-decoration: none;
    border-bottom: 1px solid rgba(201, 211, 245, 0.45);
    padding-bottom: 3px;
    align-self: flex-start;
  }
  .head-link:hover {
    color: #fff;
    border-bottom-color: #fff;
  }

  @media (max-width: 900px) {
    /*
      En escritorio la casa cruza de lado a lado y el texto vive a su
      izquierda/derecha. En móvil no hay ancho para las dos cosas a la vez
      sin que se pisen, así que la casa se queda centrada y se anima en
      vertical (sube/baja un poco con el scroll, ver --ry en el script),
      con la primera frase arriba del todo y la segunda abajo del todo,
      aprovechando el alto de la pantalla en vez del ancho.
    */
    .reel-house {
      width: 58vw;
      top: 50%;
      left: 50%;
      transform: translate(-50%, calc(-50% + var(--ry, 0) * 1vh));
    }
    .reel-kick {
      top: 9vh;
      left: 0;
      right: 0;
      text-align: center;
      padding: 0 24px;
    }
    .reel-phrase {
      position: absolute;
      left: 0;
      right: 0;
      top: auto;
      transform: none;
      width: auto;
      padding: 0 24px;
      text-align: center;
      font-size: 8vw;
    }
    .reel-p1 {
      top: 14vh;
    }
    .reel-p2 {
      bottom: 10vh;
      text-align: center;
    }
    /*
      En móvil el wordmark deja de recrearse con texto y pasa a ser el logo
      vertical OFICIAL del manual (design/logo/perfil-*, recortado al trazo en
      public/logo/perfil-blanco.svg).

      Por qué: la versión de texto intentaba imitar el logo con una rejilla de
      dos columnas y no da la talla. En el logo real las dos palabras gruesas
      van escalonadas hacia la derecha (NO comparten borde izquierdo) y la
      manuscrita se SOLAPA sobre la negrita: eso no se reproduce con dos
      columnas, se salga por donde se salga. Usando el SVG oficial, el logo es
      el logo, sin reinterpretaciones.

      Va casi a sangre (16px por lado), como el horizontal en escritorio.
      El texto sigue en el <h1> para buscadores y lectores de pantalla, solo
      que oculto a la vista.
    */
    .logo-h1 {
      display: block;
      padding: 0 16px;
      width: 100%;
      box-sizing: border-box;
      white-space: normal;
    }
    .logo-h1 .scr,
    .logo-h1 .hvy {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .logo-h1 .logo-img {
      display: block;
      width: 100%;
      height: auto;
    }
  }
  /*
    ── El gráfico de cada diapositiva ────────────────────────────────────────

    Va en el lado que el texto deja libre: en `.02` el texto se pega a la
    izquierda y el gráfico ocupa la derecha, y en `.03` al revés. El lado se
    saca del marcado (`.read` / `.read.right`), no de la clase de parada que
    pone el JS, para que no dependa de que ese JS haya corrido.

    Posicionado en absoluto a propósito: así no entra en la columna de texto y
    no toca la medida de lectura ni las alturas ya verificadas.

    Solo escritorio. En un teléfono no hay lado libre: el texto ya ocupa el
    ancho entero y meter esto sería robarle sitio.
  */
  @media (min-width: 901px) {
    :global([data-slides] .read) {
      position: relative;
    }
    .slide-art {
      position: absolute;
      top: 50%;
      translate: 0 -50%;
      width: min(34%, 360px);
      max-width: none;
      pointer-events: none;
    }
    :global(.read) > .slide-art {
      right: 0;
    }
    :global(.read.right) > .slide-art {
      left: 0;
    }

    /* .02 · las ocho islas, niveladas contra una misma línea */
    .art-islas {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: clamp(6px, 0.9vw, 14px);
    }
    /*
      La plata metálica sobre campo claro NO se lee: medido sobre los propios
      archivos el 2026-08-06, el color medio de las islas es (207,207,206) y
      da 2,0:1 de contraste contra el campo. Se ve lavado.

      El manual ya tenía la respuesta: "plata adaptativa, siempre color sólido,
      #565E6C sobre campos claros". Se oscurece hasta esa familia, quitando
      parte del brillo metálico pero no todo, y sube a 3,9:1. No se usa una
      máscara con relleno sólido porque obligaría a repetir en el CSS las
      proporciones reales de cada archivo, y se rompería al cambiar una isla.
    */
    .isla-nivel {
      height: clamp(38px, 4.2vw, 62px);
      width: auto;
      transform-origin: bottom center;
      filter: grayscale(0.4) brightness(0.58) contrast(1.15);
    }

    /* .03 · el camino de tres pasos */
    .art-proceso svg {
      display: block;
      width: 100%;
      height: auto;
      max-height: 62svh;
      margin: 0 auto;
    }
    .pr-linea,
    .pr-nudo {
      stroke: var(--azul);
    }
    .pr-nudo {
      fill: var(--plata-clara);
    }
  }
  @media (max-width: 900px) {
    .slide-art {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel { height: auto; }
    .reel-stage { position: static; height: auto; padding: 10vh 0; }
    .reel-house { position: relative; transform: none; margin: 0 auto; }
    .reel-house .r3 { opacity: 1; }
    .reel-p1, .reel-kick { opacity: 0; }
    .reel-p2 { opacity: 1; position: static; text-align: center; margin: 20px auto; }
    .cta-inner { transform: none; opacity: 1; }
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
  const ramp = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  // logo llena el ancho
  const h1 = document.querySelector<HTMLElement>(".logo-h1");
  const fitLogo = () => {
    if (!h1) return;
    // En móvil el wordmark es de dos líneas (tamaño fijo por CSS), no hace falta encogerlo.
    if (matchMedia("(max-width: 900px)").matches) {
      h1.style.removeProperty("--logo");
      return;
    }
    const base = innerWidth * 0.1;
    h1.style.setProperty("--logo", base + "px");
    const kids = Array.from(h1.children) as HTMLElement[];
    const words = kids.reduce((s, k) => s + k.getBoundingClientRect().width, 0);
    const gaps = (kids.length - 1) * base * 0.06;
    const avail = h1.clientWidth - 40;
    if (words > 0) h1.style.setProperty("--logo", (base * (avail / (words + gaps))).toFixed(2) + "px");
  };
  if (document.fonts) document.fonts.ready.then(fitLogo);
  fitLogo();
  addEventListener("resize", fitLogo);

  if (!reduce) {
    const reel = document.getElementById("reel");
    const stage = document.getElementById("reelStage");
    if (reel && stage) {
      const reelUpdate = () => {
        const r = reel.getBoundingClientRect();
        const total = reel.offsetHeight - innerHeight;
        const p = total > 0 ? clamp01(-r.top / total) : 0;
        // ±16, no ±22: ver el comentario de .reel-house sobre los márgenes.
        stage.style.setProperty("--rx", lerp(16, -16, p).toFixed(2));
        // Tramos estirados para que la casa acabe de pintarse al 80% y la frase
        // cierre al 92%: antes todo terminaba al 74% y el resto era scroll vacío.
        stage.style.setProperty("--o30", ramp(p, 0.1, 0.32).toFixed(3));
        stage.style.setProperty("--o70", ramp(p, 0.3, 0.56).toFixed(3));
        stage.style.setProperty("--o100", ramp(p, 0.54, 0.8).toFixed(3));
        stage.style.setProperty("--p1", (1 - ramp(p, 0.2, 0.46)).toFixed(3));
        stage.style.setProperty("--p2", ramp(p, 0.6, 0.92).toFixed(3));
      };

      /*
        Acelerador simple por fotograma, el mismo patrón que usa el
        archipiélago. Sustituye a una máquina de estados con contador de reposo
        que guardaba un `ticking` que, si no volvía a false, dejaba de repintar
        para siempre. No está demostrado que llegara a pasar, pero no aporta
        nada frente a esto y sí tiene por dónde romperse.
      */
      let pendiente = false;
      const alScroll = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          reelUpdate();
          pendiente = false;
        });
      };
      reelUpdate();
      addEventListener("scroll", alScroll, { passive: true });
      addEventListener("resize", alScroll, { passive: true });
    }

    const cta = document.getElementById("ctaScreen");
    if (cta) {
      new IntersectionObserver(
        (es, o) => {
          es.forEach((e) => {
            if (e.isIntersecting) {
              cta.classList.add("in");
              o.disconnect();
            }
          });
        },
        { threshold: 0.35 }
      ).observe(cta);
    }

    // El campo "qué necesitas" se abre al tocar el correo, no de entrada.
    const ctaform = document.getElementById("ctaform");
    const ctaEmail = ctaform?.querySelector<HTMLInputElement>('input[type="email"]');
    if (ctaform && ctaEmail) {
      ctaform.classList.add("compacto");
      ctaEmail.addEventListener("focus", () => ctaform.classList.remove("compacto"), { once: true });
    }
  }
</script>

<script>
  /*
    Los gráficos de las diapositivas .02 y .03, con GSAP + ScrollTrigger.

    GSAP va como dependencia del proyecto, NO desde un CDN ajeno: así no se
    añade una conexión a un tercero (el mismo problema que ya arrastramos con
    la tipografía de Google) ni dependemos de que el servidor de otro esté vivo.

    Se queda para lo nuevo. Las tres coreografías que ya existen (el reel, la
    historia de Sobre Atis y los pasos de Cómo trabajamos) siguen con su cálculo
    a mano: funcionan y están medidas, y reescribirlas solo mete riesgo.
  */
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { contarCifras } from "../scripts/entradas";

  gsap.registerPlugin(ScrollTrigger);

  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const escritorio = matchMedia("(min-width: 901px)").matches;

  // .05 · Las cifras cuentan. También en móvil: no ocupa sitio, solo anima un
  // número que ya está ahí.
  contarCifras(".datos .big");

  if (!quieto && escritorio) {
    /*
      .02 · Las ocho islas se nivelan.

      Entran desiguales, a distintas alturas y tamaños, y acaban todas en la
      misma línea y al mismo alto. Los desniveles son fijos, no aleatorios: el
      dibujo tiene que ser el mismo en cada visita, no una tirada de dados.
    */
    const islas = gsap.utils.toArray<HTMLElement>(".art-islas .isla-nivel");
    if (islas.length) {
      const altura = [34, -22, 46, -34, 26, -42, 18, 38];
      const tamano = [0.45, 1.35, 0.6, 1.5, 0.5, 1.25, 0.7, 0.4];
      gsap.from(islas, {
        scrollTrigger: {
          trigger: ".art-islas",
          start: "top 78%",
          // Se rearma al volver a subir, como el resto del revelado del sitio.
          toggleActions: "play none none reverse",
        },
        y: (i: number) => altura[i] ?? 0,
        scale: (i: number) => tamano[i] ?? 1,
        opacity: 0,
        duration: 0.9,
        ease: "power3.out",
        stagger: 0.07,
      });
    }

    /*
      .03 · El camino de tres pasos se dibuja hacia abajo.

      Sin DrawSVG: `stroke-dasharray` hace lo mismo para una línea recta y
      ahorra un plugin. Cada nudo se enciende en el instante EXACTO en que el
      trazo pasa por él, calculado desde su propia `cy`, para no tener que
      cuadrar tiempos a mano si mañana se mueve un nudo.
    */
    const linea = document.querySelector<SVGPathElement>(".pr-linea");
    const nudos = gsap.utils.toArray<SVGCircleElement>(".pr-nudo");
    if (linea && nudos.length) {
      const largo = linea.getTotalLength();
      const DE = 24;
      const A = 396;
      const DURACION = 1.6;

      gsap.set(linea, { strokeDasharray: largo, strokeDashoffset: largo });
      gsap.set(nudos, { scale: 0, transformOrigin: "center center" });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".art-proceso",
          start: "top 78%",
          toggleActions: "play none none reverse",
        },
      });
      tl.to(linea, { strokeDashoffset: 0, duration: DURACION, ease: "none" });
      nudos.forEach((nudo) => {
        const cy = Number(nudo.getAttribute("cy"));
        const cuando = ((cy - DE) / (A - DE)) * DURACION;
        tl.to(nudo, { scale: 1, duration: 0.35, ease: "back.out(2)" }, cuando);
      });
    }
  }
</script>
