<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
  const ramp = (p: number, a: number, b: number) => clamp01((p - a) / (b - a));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  // logo llena el ancho
  const h1 = document.querySelector<HTMLElement>(".logo-h1");
  const fitLogo = () => {
    if (!h1) return;
    // En móvil el wordmark es de dos líneas (tamaño fijo por CSS), no hace falta encogerlo.
    if (matchMedia("(max-width: 900px)").matches) {
      h1.style.removeProperty("--logo");
      return;
    }
    const base = innerWidth * 0.1;
    h1.style.setProperty("--logo", base + "px");
    const kids = Array.from(h1.children) as HTMLElement[];
    /*
      Se descuenta la escala con la que entra el logo en la portada. Sin esto,
      lo medido son las palabras YA ENCOGIDAS: el ajuste cree que le sobra
      sitio y agranda el cuerpo un 43%, así que al llegar a su posición final
      el logo se sale de la pantalla por los dos lados.
    */
    const escala = new DOMMatrixReadOnly(getComputedStyle(h1).transform).a || 1;
    const words = kids.reduce((s, k) => s + k.getBoundingClientRect().width / escala, 0);
    const gaps = (kids.length - 1) * base * 0.06;
    const avail = h1.clientWidth - 40;
    if (words > 0) h1.style.setProperty("--logo", (base * (avail / (words + gaps))).toFixed(2) + "px");
  };
  if (document.fonts) document.fonts.ready.then(fitLogo);
  fitLogo();
  addEventListener("resize", fitLogo);

  /*
    ── Portada en dos tiempos ───────────────────────────────────────────────

    El logo y el claim arrancan centrados en la pantalla, con el claim grande y
    parado. Con el primer gesto de scroll el conjunto sube a su sitio, el claim
    se encoge hasta ser el carril y ECHA A CORRER (no se apaga para dar paso a
    otro: es el mismo elemento).

    Solo escritorio. En móvil el logo de la portada es el vertical y el carril
    ya está en su sitio desde el principio, así que aquí no se toca nada más
    allá de soltar el desfile.
  */
  {
    const pin = document.querySelector<HTMLElement>(".portada-pin");
    const portada = document.getElementById("portada");
    const heroEl = document.querySelector<HTMLElement>(".hero");
    const claim = document.getElementById("claimPortada");
    const logo = document.querySelector<HTMLElement>(".logo-h1");
    /*
      Las variables de la entrada viven en la RAÍZ, no en la portada: la casa es
      hermana de la portada, no hija, y también las necesita para viajar pegada
      al carril. Desde la raíz las hereda toda la página.
    */
    const raiz = document.documentElement;
    /*
      Lo que encoge el logo en la portada. Tiene que valer lo mismo que el 0.3
      de `scale(calc(1 - 0.3 * var(--intro)))` de ahí arriba: si se cambia uno,
      se cambia el otro, o el claim dejará de medir lo que mide el logo.
    */
    const LOGO_MIN = 0.7;
    // Ancho de las PALABRAS, no de la caja: el <h1> ocupa las doce columnas.
    const palabras = (el: HTMLElement) => {
      const cajas = Array.from(el.children)
        .map((k) => k.getBoundingClientRect())
        .filter((r) => r.width > 0);
      if (!cajas.length) return 0;
      return Math.max(...cajas.map((r) => r.right)) - Math.min(...cajas.map((r) => r.left));
    };
    const grande = matchMedia("(min-width: 901px)");
    const hayIntro = () => !!(pin && portada && heroEl) && grande.matches && !reduce;


    if (pin && portada && heroEl) {
      /*
        El desplazamiento hasta el centro se MIDE, no se estima: es el hueco
        que queda entre el alto del bloque (con el claim ya crecido, que no
        ocupa sitio de maquetación porque crece por transformación) y la
        pantalla. Así encaja en cualquier alto de ventana.
      */
      let dy = 0;
      const medirIntro = () => {
        if (!hayIntro()) {
          raiz.style.removeProperty("--intro-dy");
          raiz.style.removeProperty("--claim-ancho");
          raiz.style.removeProperty("--claim-esc-tope");
          return;
        }
        /*
          Todo se mide con la portada YA COLOCADA (`--intro: 0`), o sea en su
          estado final, y desde ahí se calcula cuánto hay que mover cada pieza
          para componer la pantalla de entrada. Medir en el estado intermedio
          daba números falsos: con el carril todavía pequeño el bloque mide 278
          px en vez de 306 y la casa subía 28 px de más, metiéndose debajo.
        */
        const previo = raiz.style.getPropertyValue("--intro");
        raiz.style.setProperty("--intro", "0");
        raiz.style.setProperty("--intro-dy", "0px");

        const alto = heroEl.offsetHeight;
        const anchoLogo = logo ? palabras(logo) : 0;
        // La FRASE sola, sin el separador: es lo que tiene que llenar el ancho
        // del logo en la portada. Con la copia entera se colaba el punto.
        const unaCopia = claim?.querySelector(".frase")?.getBoundingClientRect().width ?? 0;

        /*
          Cuánto tiene que subir la casa para quedar justo debajo del logo: el
          hueco que sobra de la pantalla anclada. Se mide del propio bloque
          porque su alto depende del logo, que se ajusta al ancho de ventana.
        */
        raiz.style.setProperty("--hero-h", alto + "px");

        /*
          En la portada el logo va encogido, así que la caja del claim tiene que
          ir a ESE ancho, no al final. Y la letra tiene que crecer justo lo
          necesario para que una sola copia de la frase lo llene: ni una palabra
          de más asomando por los lados, ni un hueco.
        */
        const anchoPortada = anchoLogo * LOGO_MIN;
        if (anchoPortada > 0 && unaCopia > 0) {
          raiz.style.setProperty("--claim-ancho", anchoPortada.toFixed(1) + "px");
          raiz.style.setProperty("--claim-esc-tope", (anchoPortada / unaCopia).toFixed(4));
        }

        /*
          Y ahora, ya con la portada compuesta, se centra el conjunto: se mide
          de arriba del logo a abajo del claim, que es lo que se ve, no la caja
          del bloque, que no coincide porque el claim va más grande.
        */
        raiz.style.setProperty("--intro", "1");
        const arriba = logo?.getBoundingClientRect().top ?? 0;
        const abajo = claim?.getBoundingClientRect().bottom ?? 0;
        raiz.style.setProperty("--intro", previo || "1");

        dy = (innerHeight - (abajo - arriba)) / 2 - arriba;
        raiz.style.setProperty("--intro-dy", dy.toFixed(1) + "px");
      };

      const introUpdate = () => {
        if (!hayIntro()) {
          raiz.style.setProperty("--intro", "0");
          return;
        }
        const total = portada.offsetHeight - innerHeight;
        const p = total > 0 ? clamp01(-portada.getBoundingClientRect().top / total) : 1;
        raiz.style.setProperty("--intro", (1 - p).toFixed(3));
        /*
          El desfile NO se para en ningún momento (2026-08-09). Se probaron las
          dos cosas: arrancar al primer gesto y esperar a ser carril; Alejandro
          quiere que la frase se mueva **desde que se ve**, con la caja al
          ancho del logo, y que lo que crezca sea solo la caja. Aquí no queda
          nada que decidir, por eso este hueco.
        */
      };

      medirIntro();
      introUpdate();
      /*
        ── Mientras la carga está puesta, la entrada se vigila cada fotograma ──

        Es el arreglo del fallo que Alejandro veía al recargar: la pantalla de
        carga se retiraba y aparecía el logo arriba con una franja blanca
        debajo, y solo al deslizar salía la portada. El motivo es que el estado
        de la entrada se calcula desde EVENTOS de scroll, y en el arranque hay
        movimientos de página que no siempre los disparan (la restauración del
        navegador al recargar, y la corrección que hace la propia pantalla de
        carga). Si uno de esos se pierde, la entrada se queda creyendo que ya
        has bajado —el logo colocado arriba— mientras la página está en 0 y la
        casa, que se posiciona con el scroll, todavía no ha llegado: entre el
        carril y la casa se ve el fondo blanco.

        Vigilando por fotograma no hay evento que perder. Solo dura lo que dura
        la carga, que es cuando puede pasar; después manda el scroll como
        siempre.
      */
      /*
        Enganche para la pantalla de carga. Al retirarse, ella devuelve la
        página arriba y acto seguido MIDE dónde está el logo para aterrizar el
        suyo encima. Entre las dos cosas hace falta recolocar la portada aquí
        mismo, en el momento, porque si no el logo de la carga aterrizaría sobre
        la posición vieja —la de la home ya bajada— y al fotograma siguiente el
        de la portada saltaría a su sitio.
      */
      (window as any).atisColocarPortada = () => {
        medirIntro();
        introUpdate();
      };

      const vigilar = () => {
        introUpdate();
        if (document.documentElement.classList.contains("cargando")) {
          requestAnimationFrame(vigilar);
        }
      };
      requestAnimationFrame(vigilar);
      // Volver atrás en el navegador restaura la página desde su caché, y ahí
      // no hay carga ni scroll: se recoloca a mano.
      addEventListener("pageshow", () => {
        medirIntro();
        introUpdate();
      });
      addEventListener(
        "scroll",
        () => requestAnimationFrame(introUpdate),
        { passive: true }
      );
      addEventListener(
        "resize",
        () => {
          medirIntro();
          introUpdate();
        },
        { passive: true }
      );
      if (document.fonts) document.fonts.ready.then(medirIntro);
      /*
        Y se vuelve a medir cada vez que el bloque cambia de alto. El alto
        depende del logo, que lo dimensiona otro script cuando cargan las
        fuentes: si esa medida se queda vieja, la casa sube de menos y por el
        hueco se ve el fondo blanco de la página.
      */
      if ("ResizeObserver" in window) new ResizeObserver(() => medirIntro()).observe(heroEl);
      /*
        Red de seguridad (misma idea que en reveal.ts): si algo dejara el guion
        mudo con la página ya bajada, la portada se quedaría desplegada encima
        del contenido. A los 6 s se recalcula, y si ya no toca estar en la
        portada, se coloca.
      */
      setTimeout(() => {
        if (scrollY > innerHeight * 0.9) introUpdate();
      }, 6000);
    }
  }

  if (!reduce) {
    const reel = document.getElementById("reel");
    const stage = document.getElementById("reelStage");
    if (reel && stage) {
      const reelUpdate = () => {
        const r = reel.getBoundingClientRect();
        const total = reel.offsetHeight - innerHeight;
        const p = total > 0 ? clamp01(-r.top / total) : 0;
        // ±16, no ±22: ver el comentario de .reel-house sobre los márgenes.
        stage.style.setProperty("--rx", lerp(16, -16, p).toFixed(2));
        // Tramos estirados para que la casa acabe de pintarse al 80% y la frase
        // cierre al 92%: antes todo terminaba al 74% y el resto era scroll vacío.
        stage.style.setProperty("--o30", ramp(p, 0.1, 0.32).toFixed(3));
        stage.style.setProperty("--o70", ramp(p, 0.3, 0.56).toFixed(3));
        stage.style.setProperty("--o100", ramp(p, 0.54, 0.8).toFixed(3));
        stage.style.setProperty("--p1", (1 - ramp(p, 0.2, 0.46)).toFixed(3));
        stage.style.setProperty("--p2", ramp(p, 0.6, 0.92).toFixed(3));
      };

      /*
        Acelerador simple por fotograma, el mismo patrón que usa el
        archipiélago. Sustituye a una máquina de estados con contador de reposo
        que guardaba un `ticking` que, si no volvía a false, dejaba de repintar
        para siempre. No está demostrado que llegara a pasar, pero no aporta
        nada frente a esto y sí tiene por dónde romperse.
      */
      let pendiente = false;
      const alScroll = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          reelUpdate();
          pendiente = false;
        });
      };
      reelUpdate();
      addEventListener("scroll", alScroll, { passive: true });
      addEventListener("resize", alScroll, { passive: true });
    }

    const cta = document.getElementById("ctaScreen");
    if (cta) {
      new IntersectionObserver(
        (es, o) => {
          es.forEach((e) => {
            if (e.isIntersecting) {
              cta.classList.add("in");
              o.disconnect();
            }
          });
        },
        { threshold: 0.35 }
      ).observe(cta);
    }

    // El campo "qué necesitas" se abre al tocar el correo, no de entrada.
    const ctaform = document.getElementById("ctaform");
    const ctaEmail = ctaform?.querySelector<HTMLInputElement>('input[type="email"]');
    if (ctaform && ctaEmail) {
      ctaform.classList.add("compacto");
      ctaEmail.addEventListener("focus", () => ctaform.classList.remove("compacto"), { once: true });
    }
  }
</script>

<script>
  /*
    Los gráficos de las diapositivas .02 y .03, con GSAP + ScrollTrigger.

    GSAP va como dependencia del proyecto, NO desde un CDN ajeno: así no se
    añade una conexión a un tercero (el mismo problema que ya arrastramos con
    la tipografía de Google) ni dependemos de que el servidor de otro esté vivo.

    Se queda para lo nuevo. Las tres coreografías que ya existen (el reel, la
    historia de Sobre Atis y los pasos de Cómo trabajamos) siguen con su cálculo
    a mano: funcionan y están medidas, y reescribirlas solo mete riesgo.
  */
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { contarCifras } from "../scripts/entradas";

  gsap.registerPlugin(ScrollTrigger);

  const quieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const escritorio = matchMedia("(min-width: 901px)").matches;

  // .05 · Las cifras cuentan. También en móvil: no ocupa sitio, solo anima un
  // número que ya está ahí.
  contarCifras(".datos .big");

  if (!quieto && escritorio) {
  }
</script>
