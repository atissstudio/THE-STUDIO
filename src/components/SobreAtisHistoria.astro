---
/*
  "Sobre Atis" — el mar, las islas y el zoom (2026-08-05, rehecho).

  Una sola diapositiva anclada durante toda la sección: el mar de fondo
  (degradado azul oscuro a negro) con las ocho islas encima, minimalistas,
  pequeñas pero visibles, en su posición geográfica REAL (proyectada desde
  longitud y latitud, no colocada a ojo).

  Cada escena viaja y hace zoom sobre una isla concreta hasta que la plata
  llena la pantalla como campo plano, y ahí el texto se lee en NEGRO. La
  última no hace zoom: sale del fondo, alejándose hasta descubrir el mar
  entero.

  Por qué el fondo acaba en plata PLANA y no en la isla ampliada: para que una
  isla llene la pantalla haría falta ampliar su imagen unas 5,4 veces, y se
  vería el pixelado. Cruzando a plata plana antes de llegar, el desenfoque no
  aparece nunca y además es lo que se pidió.

  Igual en móvil y en escritorio: son transformaciones y opacidades, baratas
  también en un teléfono.
*/

interface Isla {
  n: string;
  f: string;
  x: number;
  y: number;
  w: number;
}

const islas: Isla[] = [
  { n: "el-hierro", f: "isla-08", x: 6.0, y: 82.0, w: 9 },
  { n: "la-palma", f: "isla-06", x: 8.9, y: 42.4, w: 8 },
  { n: "la-gomera", f: "isla-07", x: 20.7, y: 66.6, w: 7.5 },
  { n: "tenerife", f: "isla-05", x: 33.4, y: 57.8, w: 22 },
  { n: "gran-canaria", f: "isla-01", x: 52.9, y: 71.0, w: 13 },
  { n: "fuerteventura", f: "isla-02", x: 77.4, y: 53.4, w: 19 },
  { n: "lanzarote", f: "isla-03", x: 91.1, y: 24.8, w: 12 },
  { n: "la-graciosa", f: "isla-04", x: 94.0, y: 16.0, w: 4.5 },
];

const pos = Object.fromEntries(islas.map((i) => [i.n, i]));

/*
  Las tres escenas hacen zoom sobre las tres islas mayores: son las que
  aguantan la ampliación con menos pixelado y las que cualquiera reconoce.
  La cuarta se aleja.
*/
const escenas = [
  {
    titulo: "El éxodo",
    isla: "tenerife",
    html: `Crecimos en un <b>paraíso</b>. Pero un paraíso que, poco a poco, veíamos <b>apagarse</b>. Los que querían oportunidades y se lo podían permitir, volaban apenados dejando atrás su tierra y a sus familias. Nosotros fuimos parte de ese vuelo.`,
  },
  {
    titulo: "El retorno",
    isla: "gran-canaria",
    html: `Pero decidimos <b>volver</b>. Volver con todo lo aprendido en la maleta. No queríamos seguir buscando oportunidades fuera, queríamos traerlas <b>a casa</b> para devolver a las islas todo lo que han hecho por nosotros.`,
  },
  {
    titulo: "El nacimiento de Atis",
    isla: "fuerteventura",
    html: `Así nació <b>Atis Studio</b>. Más que una empresa, somos una <b>cooperativa</b>. Un proyecto <b>modular</b> creado para dar soluciones a las adversidades de Canarias. Creemos que un negocio solo es verdaderamente exitoso si gana en lo económico, pero también en lo <b>social, cultural y medioambiental</b>.`,
  },
];

const cierre = {
  titulo: "El primer paso",
  h2: "Nuestra primera misión, the Studio.",
  parrafos: [
    "Para cambiar las cosas, empezamos por los nuestros. Hemos creado una agencia que democratiza el marketing, la estrategia y la inteligencia artificial.",
    "Le damos al negocio canario de toda la vida las herramientas de las multinacionales para que vuelva a competir y ganar.",
  ],
};

const tramos = escenas.length + 1;
---

<section id="historia" class="historia" style={`--tramos:${tramos}`}>
  <div class="escenario" id="escenario">
    <!-- El mar: degradado azul oscuro a negro -->
    <div class="mar"></div>

    <!-- Las islas, en su sitio real -->
    <div class="mapa" id="mapa" aria-hidden="true">
      {
        islas.map((i) => (
          <img
            class={`isla isla-${i.n}`}
            src={`/plata/${i.f}.webp`}
            alt=""
            loading="lazy"
            style={`--x:${i.x}%; --y:${i.y}%; --w:${i.w}%`}
          />
        ))
      }
    </div>

    <!-- Campo de plata plana: toma el relevo al final del zoom -->
    <div class="plata" id="plata"></div>

    <p class="sr-only">
      El archipiélago canario, con las ocho islas en su posición real, dibujado en plata líquida sobre
      el mar.
    </p>

    {
      escenas.map((e, i) => (
        <article class="escena" data-escena={i}>
          <div class="texto">
            <span class="k">{e.titulo}</span>
            <p set:html={e.html} />
          </div>
        </article>
      ))
    }

    <article class="escena cierre" data-escena={escenas.length}>
      <div class="texto">
        <span class="k">{cierre.titulo}</span>
        <h2>{cierre.h2}</h2>
        {cierre.parrafos.map((p) => <p>{p}</p>)}
      </div>
    </article>
  </div>
</section>

<script define:vars={{ escenas, pos, tramos }}>
  const historia = document.getElementById("historia");
  const escenario = document.getElementById("escenario");
  const mapa = document.getElementById("mapa");

  if (historia && escenario && mapa && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const paneles = Array.from(escenario.querySelectorAll(".escena"));
    const clamp01 = (n) => Math.min(1, Math.max(0, n));
    const tramo = (p, a, b) => clamp01((p - a) / (b - a));
    const lerp = (a, b, t) => a + (b - a) * t;

    // Zoom máximo por escena. No llega a llenar del todo: la plata plana
    // remata el último trecho, y así nunca se ve el bitmap pixelado.
    const ZOOM = 3.6;

    let activo = -1;

    const pintar = () => {
      const r = historia.getBoundingClientRect();
      const total = historia.offsetHeight - innerHeight;
      const p = total > 0 ? clamp01(-r.top / total) : 0;
      const bruto = p * tramos;
      const i = Math.min(tramos - 1, Math.floor(bruto));
      const dentro = clamp01(bruto - i);

      if (i !== activo) {
        activo = i;
        paneles.forEach((el, n) => el.classList.toggle("activa", n === i));
      }

      const ultima = i === tramos - 1;

      if (!ultima) {
        // Viaja y amplía sobre su isla; la plata entra en la segunda mitad.
        const isla = pos[escenas[i].isla];
        mapa.style.setProperty("--ox", `${isla.x}%`);
        mapa.style.setProperty("--oy", `${isla.y}%`);
        mapa.style.setProperty("--z", `${lerp(1.15, ZOOM, tramo(dentro, 0, 0.62))}`);
        escenario.style.setProperty("--plata-op", `${tramo(dentro, 0.42, 0.62)}`);
        // El texto entra cuando la plata ya manda, para leerse en negro.
        escenario.style.setProperty("--t-op", `${tramo(dentro, 0.52, 0.7)}`);
      } else {
        // Sale del fondo: la plata se retira y el mar se descubre entero.
        mapa.style.setProperty("--ox", "50%");
        mapa.style.setProperty("--oy", "50%");
        mapa.style.setProperty("--z", `${lerp(2.4, 1, tramo(dentro, 0, 0.55))}`);
        escenario.style.setProperty("--plata-op", `${1 - tramo(dentro, 0, 0.4)}`);
        escenario.style.setProperty("--t-op", `${tramo(dentro, 0.35, 0.6)}`);
      }
      escenario.classList.toggle("sobre-plata", !ultima);
    };

    let pendiente = false;
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pintar();
        pendiente = false;
      });
    };

    pintar();
    addEventListener("scroll", alScroll, { passive: true });
    addEventListener("resize", alScroll, { passive: true });
  } else if (escenario) {
    // Menos movimiento: mar y islas quietos, textos visibles en claro.
    escenario.style.setProperty("--t-op", "1");
    escenario.style.setProperty("--plata-op", "0");
    escenario.querySelectorAll(".escena").forEach((el) => el.classList.add("activa"));
  }
</script>

<style>
  .historia {
    position: relative;
    height: calc(var(--tramos) * 190svh);
  }
  .escenario {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* ── El mar ───────────────────────────────────────────────── */
  .mar {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 50% 18%, #16224e 0%, transparent 62%),
      linear-gradient(180deg, #0b1230 0%, #060a1a 52%, #000 100%);
  }

  /* ── Las islas ────────────────────────────────────────────── */
  .mapa {
    position: absolute;
    inset: 0;
    transform-origin: var(--ox, 50%) var(--oy, 50%);
    /*
      Se amplía tomando como punto fijo la isla de turno (transform-origin) y
      además se corre para dejarla en el centro de la pantalla. El translate va
      antes que el scale para que sus porcentajes sean de la pantalla, no del
      sistema ya escalado.
    */
    transform: translate(calc(50% - var(--ox, 50%)), calc(50% - var(--oy, 50%))) scale(var(--z, 1.15));
    will-change: transform;
  }
  .isla {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    height: auto;
    transform: translate(-50%, -50%);
    /* Minimalistas: la plata se lee, pero no compite con el texto */
    filter: brightness(0.92) saturate(0.85);
  }

  /* ── El campo de plata plana ──────────────────────────────── */
  .plata {
    position: absolute;
    inset: 0;
    opacity: var(--plata-op, 0);
    background:
      radial-gradient(120% 100% at 30% 20%, #ffffff 0%, transparent 55%),
      linear-gradient(160deg, #eef1f7 0%, #b9c0cc 46%, #eef1f7 100%);
    pointer-events: none;
  }

  /* ── Los textos ───────────────────────────────────────────── */
  .escena {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: 0 7vw;
    opacity: 0;
    pointer-events: none;
  }
  .escena.activa {
    opacity: 1;
  }
  .texto {
    max-width: 46ch;
    text-align: center;
    opacity: var(--t-op, 0);
    transform: translateY(calc((1 - var(--t-op, 0)) * 16px));
  }
  /* Sobre la plata, tinta negra; sobre el mar, plata clara */
  .escenario.sobre-plata .texto {
    color: #0d0f14;
  }
  .texto {
    color: var(--plata-clara);
  }
  .texto .k {
    display: block;
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.75;
    margin: 0 0 18px;
  }
  .texto p {
    font-family: var(--sans);
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    line-height: 1.5;
    margin: 0 0 14px;
    text-wrap: pretty;
    color: inherit;
  }
  .texto p:last-child {
    margin-bottom: 0;
  }
  .texto b {
    font-weight: 800;
  }
  .cierre h2 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 18px;
    color: inherit;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .texto {
      max-width: none;
    }
    .texto p {
      font-size: clamp(1.1rem, 4.6vw, 1.45rem);
    }
  }

  /* Menos movimiento: sin zoom ni plata, mar quieto y texto legible en claro */
  @media (prefers-reduced-motion: reduce) {
    .historia {
      height: auto;
    }
    .escenario {
      position: static;
      height: auto;
    }
    .mapa {
      position: relative;
      height: 60svh;
      transform: none;
    }
    .plata {
      display: none;
    }
    .escena {
      position: relative;
      inset: auto;
      opacity: 1;
      min-height: auto;
      padding: 8vh 7vw;
    }
    .texto {
      opacity: 1;
      transform: none;
    }
  }
</style>
