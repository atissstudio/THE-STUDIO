---
/*
  Escenas 1-3 de "Sobre Atis" (2026-08-03): tres vídeos reales, generados,
  copiados desde ~/Desktop/The Studio web/ a public/videos/sobre-atis/.

  Al terminar la escena 3, no hay corte a una sección de color plano: el
  vídeo se congela en su último fotograma (el mismo <video>, solo que deja de
  avanzar) y la tarjeta de cristal de esa escena da paso a una tarjeta más
  grande y centrada con el texto del siguiente módulo ("El primer paso"),
  para que la transición se sienta continua en vez de un salto (pedido
  2026-08-03). Ese módulo no tiene vídeo propio: usa el fondo que ya está en
  pantalla, congelado.

  La escena 5 del guion original ("El desenlace") no tiene vídeo y no se van
  a generar más, así que sigue como el cierre normal de la página, fuera de
  este componente (en sobre-atis.astro).
*/
interface Escena {
  titulo: string;
  texto: string;
  video: string;
}

const escenas: Escena[] = [
  {
    titulo: "El éxodo",
    video: "/videos/sobre-atis/escena-1.mp4",
    texto:
      "Crecimos en un paraíso. Pero un paraíso que, poco a poco, veíamos apagarse. Los que querían oportunidades y se lo podían permitir, volaban apenados dejando atrás su tierra y a sus familias. Nosotros fuimos parte de ese vuelo.",
  },
  {
    titulo: "El retorno",
    video: "/videos/sobre-atis/escena-2.mp4",
    texto:
      "Pero decidimos volver. Volver con todo lo aprendido en la maleta. No queríamos seguir buscando oportunidades fuera, queríamos traerlas a casa para devolver a las islas todo lo que han hecho por nosotros.",
  },
  {
    titulo: "El nacimiento de Atis",
    video: "/videos/sobre-atis/escena-3.mp4",
    texto:
      "Así nació Atis Studio. Más que una empresa, somos una cooperativa. Un proyecto modular creado para dar soluciones a las adversidades de Canarias. Creemos que un negocio solo es verdaderamente exitoso si gana en lo económico, pero también en lo social, cultural y medioambiental.",
  },
];

const modulo = {
  kicker: "El primer paso",
  titulo: "Nuestra primera misión, the Studio.",
  parrafos: [
    "Para cambiar las cosas, empezamos por los nuestros. Hemos creado una agencia que democratiza el marketing, la estrategia y la inteligencia artificial.",
    "Le damos al negocio canario de toda la vida las herramientas de las multinacionales para que vuelva a competir y ganar.",
  ],
};
---

<section id="historia" class="historia" style={`--tramos:${escenas.length + 1}`}>
  <div class="historia-stage" id="historiaStage">
    {
      escenas.map((e, i) => (
        <article class="escena" data-escena={i}>
          <video class="escena-video" src={e.video} muted playsinline preload="auto" loop />
          <div class="escena-velo" />
          <div class="escena-texto">
            <span class="k">
              Escena {i + 1} · {e.titulo}
            </span>
            <p>{e.texto}</p>
          </div>
        </article>
      ))
    }

    {/* El módulo comparte el fondo de la última escena, congelado; no lleva vídeo propio. */}
    <div class="modulo-texto" id="moduloTexto">
      <span class="k">{modulo.kicker}</span>
      <h2>{modulo.titulo}</h2>
      {modulo.parrafos.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  /*
    Alto total: cada escena, más el módulo final, se lleva su propio tramo de
    scroll (220vh). Dentro, el "stage" queda pegado (sticky) mientras se
    consume ese tramo.
  */
  .historia {
    position: relative;
    height: calc(var(--tramos) * 220vh);
    background: var(--navy);
  }
  .historia-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .escena {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease;
  }
  .escena.activa {
    opacity: 1;
    visibility: visible;
  }
  /*
    Zoom para sacar de encuadre la marca de agua del generador de vídeo
    (esquina inferior izquierda). Object-fit:cover ya recorta para llenar la
    caja; este escalado adicional recorta un poco más y desplaza el encuadre
    hacia arriba-derecha, justo para dejar la marca fuera por ese lado.
  */
  /*
    Vídeo más transparente y con degradado azul oscuro a negro por debajo
    (pedido 2026-08-03): disimula la calidad del vídeo generado y hace que se
    lea mejor el texto, en vez de competir con un vídeo nítido de fondo.
  */
  .escena-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    transform: scale(1.28) translate(3%, -3%);
    transform-origin: center;
  }
  /*
    Viñeta: oscurece de las esquinas hacia el centro (radial), no de arriba a
    abajo. Da profundidad y deja el centro del vídeo más despejado.
  */
  .escena-velo {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 100% at 50% 50%,
      rgba(11, 18, 48, 0.15) 0%,
      rgba(11, 18, 48, 0.55) 60%,
      #000 100%
    );
  }

  /*
    Tarjeta de cristal (liquid glass, mismo lenguaje que GlassButton): flota
    sobre el vídeo, anclada a un lado u otro según la escena sea impar o par,
    y se ilumina (más opaca, con halo azul) solo cuando su escena está activa.
  */
  .escena-texto,
  .modulo-texto {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 6%;
    max-width: 460px;
    padding: 34px 36px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(22px) saturate(1.5);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 22px;
    box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.28);
    opacity: 0;
    transform: translateY(-50%) translateX(-16px);
    transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.75, 0.2, 1),
      box-shadow 0.8s ease, background 0.8s ease;
  }
  /* Escenas pares (2ª, 4ª...): la tarjeta cambia de lado, a la derecha */
  .escena:nth-child(even) .escena-texto {
    left: auto;
    right: 6%;
    transform: translateY(-50%) translateX(16px);
  }
  .escena.card-activa .escena-texto,
  .modulo-texto.activa {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
    background: rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 70px -22px rgba(51, 75, 164, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.32),
      0 0 70px 4px rgba(111, 134, 224, 0.28);
  }
  .escena-texto .k,
  .modulo-texto .k {
    display: block;
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--plata-clara);
    opacity: 0.8;
    margin: 0 0 16px;
  }
  .escena-texto p,
  .modulo-texto p {
    font-family: var(--sans);
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    color: #fff;
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .escena-texto p:last-child,
  .modulo-texto p:last-child {
    margin-bottom: 0;
  }

  /*
    El módulo: la tarjeta grande y centrada que da continuidad al terminar el
    vídeo. Mismo cristal, pero más grande, en el centro, y sin lado fijo.
  */
  .modulo-texto {
    left: 50%;
    top: 50%;
    max-width: 620px;
    width: min(88vw, 620px);
    padding: 48px 52px;
    transform: translate(-50%, -50%) scale(0.88);
  }
  .modulo-texto h2 {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 18px;
  }
  .modulo-texto.activa {
    transform: translate(-50%, -50%) scale(1);
  }

  @media (max-width: 900px) {
    .escena-texto {
      left: 20px;
      right: 20px;
      top: auto;
      bottom: 8vh;
      max-width: none;
      transform: translateY(16px);
    }
    .escena:nth-child(even) .escena-texto {
      left: 20px;
      right: 20px;
      transform: translateY(16px);
    }
    .escena.activa .escena-texto {
      transform: translateY(0);
    }
    .modulo-texto {
      width: calc(100vw - 40px);
      padding: 30px 26px;
      transform: translate(-50%, -50%) scale(0.94);
    }
    .modulo-texto.activa {
      transform: translate(-50%, -50%) scale(1);
    }
  }

  /* Sin scroll-scrubbing (menos movimiento, o JS que no llega a arrancar): flujo normal, vídeo en bucle */
  @media (prefers-reduced-motion: reduce) {
    .historia {
      height: auto;
    }
    .historia-stage {
      position: static;
      height: auto;
    }
    .escena {
      position: relative;
      opacity: 1;
      visibility: visible;
      height: 70vh;
      min-height: 420px;
      border-bottom: 1px solid rgba(238, 241, 247, 0.14);
    }
    .modulo-texto {
      position: relative;
      left: auto;
      top: auto;
      margin: 48px auto;
      transform: none;
    }
    /*
      La tarjeta solo se enciende con la clase "activa", que en este modo el
      JS no llega a poner (no hay tramo "activo" cuando todo se ve a la vez).
      Sin esto el texto se quedaría invisible para siempre. Nunca se oculta.
    */
    .escena-texto,
    .modulo-texto {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const historia = document.getElementById("historia");
  const stage = document.getElementById("historiaStage");
  const moduloTexto = document.getElementById("moduloTexto");

  if (historia && stage && moduloTexto && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const escenas = Array.from(stage.querySelectorAll<HTMLElement>(".escena"));
    const videos = escenas.map((e) => e.querySelector<HTMLVideoElement>("video")!);
    const ultima = escenas.length - 1; // índice de "El nacimiento de Atis"
    const tramos = escenas.length + 1; // + el módulo final

    // El scroll manda: ningún vídeo reproduce por su cuenta.
    videos.forEach((v) => {
      v.pause();
      v.loop = false;
    });

    const clamp01 = (n: number) => Math.min(1, Math.max(0, n));
    let activo = -1;

    function pintar() {
      const r = historia!.getBoundingClientRect();
      const total = historia!.offsetHeight - innerHeight;
      const p = total > 0 ? clamp01(-r.top / total) : 0;

      const bruto = p * tramos;
      const i = Math.min(tramos - 1, Math.floor(bruto));
      const dentro = clamp01(bruto - i);
      const enModulo = i === ultima + 1;

      if (i !== activo) {
        // El fondo de la última escena se queda puesto también durante el módulo.
        escenas.forEach((el, n) => {
          // "activa" mantiene el vídeo en pantalla (también durante el módulo, congelado).
          el.classList.toggle("activa", n === i || (enModulo && n === ultima));
          // "card-activa" es solo la propia tarjeta: se apaga del todo al entrar el módulo,
          // aunque su vídeo se quede de fondo. Antes compartía clase con "activa" y las dos
          // tarjetas (la de la escena y la del módulo) se veían a la vez, superpuestas.
          el.classList.toggle("card-activa", n === i && !enModulo);
        });
        moduloTexto!.classList.toggle("activa", enModulo);
        activo = i;
      }

      if (enModulo) {
        // Vídeo congelado en su último fotograma, ya no avanza con el scroll.
        const v = videos[ultima];
        if (v && v.duration && isFinite(v.duration) && v.currentTime < v.duration - 0.05) {
          v.currentTime = v.duration;
        }
      } else {
        const v = videos[i];
        if (v && v.duration && isFinite(v.duration)) {
          const destino = dentro * v.duration;
          // Evita seeks redundantes: el vídeo no busca un fotograma que ya tiene.
          if (Math.abs(v.currentTime - destino) > 0.04) v.currentTime = destino;
        }
      }
    }

    let pendiente = false;
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        pintar();
        pendiente = false;
      });
    };

    pintar();
    addEventListener("scroll", alScroll, { passive: true });
    addEventListener("resize", alScroll, { passive: true });
  } else {
    // Menos movimiento: cada vídeo reproduce en bucle, ambiental, sin scroll-scrubbing.
    document.querySelectorAll<HTMLVideoElement>("#historia video").forEach((v) => {
      v.loop = true;
      v.play().catch(() => {});
    });
  }
</script>
