---
/*
  Capa de shader interactiva (2026-08-05, redibujada como mar el 2026-08-10).

  Un único lienzo WebGL fijo sobre toda la página, en modo de fusión
  "soft-light". Hasta el 2026-08-10 pintaba en toda la página por igual; ahora
  el propio guion mide dónde están los campos `.f-azul` del DOM en cada
  fotograma y solo pinta ahí (fuera de esas bandas, alfa 0): sobre blanco no
  hace nada, tal como se pidió. Dentro del azul, el ruido se estira en
  horizontal y con más contraste que antes, para que lea como oleaje —sombra y
  brillo de verdad, no solo vibración— en vez de una textura genérica.

  Reacciona al puntero: cerca del cursor el agua se empuja como una estela, y
  además se dispara un anillo que se expande desde ahí, como si tocaras el
  agua. La reacción persigue al cursor con retardo para que no vaya a tirones.

  Frenos, a propósito:
    · No se carga nada si el visitante pide menos movimiento.
    · No se carga nada si el navegador no trae WebGL.
    · La biblioteca (OGL) se importa de forma diferida, después de pintar, así
      que no retrasa la primera vista. Se eligió OGL y no three.js por peso:
      unos cientos de KB frente a más de 20 MB en disco.
    · Se detiene cuando la pestaña no está visible, para no gastar batería.

  Aviso registrado en su día: INV-09 concluyó que el espectáculo tipo WebGL
  resta credibilidad con el público de Atis. Por eso la capa es sutil (opacidad
  baja) y no un fondo protagonista.
*/
---

<canvas id="shader-fondo" aria-hidden="true"></canvas>

<style>
  #shader-fondo {
    position: fixed;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
    mix-blend-mode: soft-light;
  }
  #shader-fondo.listo {
    /*
      Historial: 0.55 -> 0.28 -> 0.13 -> 0.07, bajando cada vez porque el ruido
      se leía como suciedad sobre el azul. El 2026-08-10 sube a 0.30, y no es
      una vuelta atrás: antes la capa cubría TODA la página, así que cualquier
      opacidad que hiciera visible la textura la hacía visible también sobre los
      campos claros, donde solo podía ensuciar. Ahora el shader solo pinta
      dentro de los campos azules (ver la máscara de bandas en el guion), que es
      donde tiene algo que representar: el mar. Ahí sí necesita cuerpo, o no hay
      ni sombra ni brillo que ver.

      0.3 se probó y se vio en pantalla: emborronaba el logo y el texto que
      cae encima, más estática de televisor que agua. 0.16 es el punto donde
      se nota el oleaje sin tapar lo que hay escrito por encima.
    */
    opacity: 0.16;
  }
  @media (prefers-reduced-motion: reduce) {
    #shader-fondo {
      display: none;
    }
  }
</style>

<script>
  const lienzo = document.getElementById("shader-fondo") as HTMLCanvasElement | null;

  const quiereQuieto = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const hayWebGL = (() => {
    try {
      return !!document.createElement("canvas").getContext("webgl");
    } catch {
      return false;
    }
  })();

  if (lienzo && !quiereQuieto && hayWebGL) {
    // Diferido: primero que la página pinte, después el adorno.
    const arrancar = async () => {
      const { Renderer, Program, Mesh, Triangle, Vec2 } = await import("ogl");

      const renderer = new Renderer({
        canvas: lienzo,
        alpha: true,
        // En pantallas muy densas no hace falta el doble de píxeles para un
        // ruido suave: la mitad se ve igual y cuesta la cuarta parte.
        dpr: Math.min(devicePixelRatio, 1.5),
      });
      const gl = renderer.gl;

      const vertex = `
        attribute vec2 uv;
        attribute vec2 position;
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = vec4(position, 0.0, 1.0);
        }
      `;

      /*
        ── El mar, solo sobre azul (2026-08-10) ──────────────────────────────

        Antes esto era ruido genérico sobre TODA la página: se leía como una
        textura, no como nada en concreto, y sobre los campos claros solo podía
        ensuciar (no hay "mar" que fingir ahí). Ahora la capa sabe DÓNDE están
        los campos azules de la página (`uBandas`, hasta 8 tramos verticales,
        medidos en el propio DOM — ver más abajo) y solo pinta dentro de ellos;
        fuera, alfa 0, así que sobre blanco no pasa nada, tal cual se pidió.

        Dentro del azul, el ruido deja de repartirse en octavas isótropas y se
        ESTIRA en horizontal, como oleaje real, y el contraste sube (antes se
        comprimía hacia el gris medio para dar solo "vibración"; ahora se
        expande, para que haya sombra y brillo de verdad). El puntero no solo
        empuja el muestreo (como antes): además dispara un anillo que se
        expande desde donde está, como si tocaras el agua.
      */
      const fragment = `
        precision mediump float;
        varying vec2 vUv;
        uniform float uTiempo;
        uniform vec2 uRaton;
        uniform vec2 uMedida;
        uniform vec2 uBandas[8];
        uniform int uNumBandas;

        float azar(vec2 p) {
          return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
        }

        float ruido(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          vec2 u = f * f * (3.0 - 2.0 * f);
          return mix(
            mix(azar(i + vec2(0.0, 0.0)), azar(i + vec2(1.0, 0.0)), u.x),
            mix(azar(i + vec2(0.0, 1.0)), azar(i + vec2(1.0, 1.0)), u.x),
            u.y
          );
        }

        void main() {
          vec2 uv = vUv;

          // ¿Este píxel cae dentro de algún campo azul? Si no, fuera.
          float dentro = 0.0;
          for (int i = 0; i < 8; i++) {
            if (i >= uNumBandas) continue;
            vec2 b = uBandas[i];
            if (uv.y <= b.x && uv.y >= b.y) dentro = 1.0;
          }
          if (dentro < 0.5) {
            gl_FragColor = vec4(0.5, 0.5, 0.5, 0.0);
            return;
          }

          float rel = uMedida.x / uMedida.y;
          // Oleaje: el muestreo se estira en horizontal, no es ruido isótropo.
          vec2 p = vec2(uv.x * rel * 1.2, uv.y * 0.8);
          vec2 raton = vec2(uRaton.x * rel * 1.2, uRaton.y * 0.8);

          // Cerca del puntero el agua se empuja, como una estela.
          float d = distance(p, raton);
          float tiron = exp(-d * 4.0);
          p += (p - raton) * tiron * 0.3;

          /*
            Manda la escala grande (olas), el grano fino queda casi
            testimonial. La primera versión pesaba igual las tres octavas y,
            sumada al contraste, se leía como estática de televisor, no como
            agua: demasiado ruido de alta frecuencia para el ojo.
          */
          float t = uTiempo * 0.05;
          float n = ruido(p * 2.2 + vec2(t, t * 0.3)) * 0.5;
          n += ruido(p * 6.0 - vec2(t * 1.6, t * 0.5)) * 0.32;
          n += ruido(p * 16.0 + vec2(-t * 2.1, t * 1.2)) * 0.18;

          // El anillo que se expande al tocar el agua, no solo un tirón.
          float onda = sin(d * 26.0 - uTiempo * 2.6) * exp(-d * 5.0) * 0.12;
          n += onda + tiron * 0.1;

          /*
            Contraste ampliado pero contenido: lo suficiente para que se note
            sombra y brillo, no tanto que tape el texto que hay encima. Bajado
            de 1.7 a 1.15 tras verlo en pantalla —a 1.7 el logo se leía
            borroso, no solo "sobre agua".
          */
          n = clamp(0.5 + (n - 0.5) * 1.15, 0.0, 1.0);

          gl_FragColor = vec4(vec3(n), 1.0);
        }
      `;

      const MAX_BANDAS = 8;
      const program = new Program(gl, {
        vertex,
        fragment,
        uniforms: {
          uTiempo: { value: 0 },
          uRaton: { value: new Vec2(0.5, 0.5) },
          uMedida: { value: new Vec2(1, 1) },
          uBandas: { value: new Array(MAX_BANDAS * 2).fill(0) },
          uNumBandas: { value: 0 },
        },
      });

      const malla = new Mesh(gl, { geometry: new Triangle(gl), program });

      const medir = () => {
        renderer.setSize(innerWidth, innerHeight);
        program.uniforms.uMedida.value.set(innerWidth, innerHeight);
      };
      medir();
      addEventListener("resize", medir, { passive: true });

      /*
        Dónde están los campos azules AHORA MISMO, en las mismas coordenadas
        que usa el shader (0 abajo, 1 arriba, como `uRaton`). Se mide en cada
        fotograma, no solo al cargar o al hacer resize: varias portadas
        mueven sus campos con `transform` durante el scroll (la entrada de la
        home, por ejemplo), y con una medida fija el mar se habría quedado
        pintando el sitio de ayer.
      */
      const bandasBuffer = program.uniforms.uBandas.value as number[];
      const medirBandas = () => {
        const els = document.querySelectorAll<HTMLElement>(".f-azul");
        let n = 0;
        for (const el of els) {
          if (n >= MAX_BANDAS) break;
          const r = el.getBoundingClientRect();
          if (r.bottom <= 0 || r.top >= innerHeight || r.height <= 0) continue;
          bandasBuffer[n * 2] = 1 - r.top / innerHeight;
          bandasBuffer[n * 2 + 1] = 1 - r.bottom / innerHeight;
          n++;
        }
        program.uniforms.uNumBandas.value = n;
      };

      // El puntero se persigue con retardo: el salto seco se vería artificial.
      const destino = { x: 0.5, y: 0.5 };
      const actual = { x: 0.5, y: 0.5 };
      const apuntar = (x: number, y: number) => {
        destino.x = x / innerWidth;
        destino.y = 1 - y / innerHeight;
      };
      addEventListener("pointermove", (e) => apuntar(e.clientX, e.clientY), { passive: true });

      let vivo = true;
      document.addEventListener("visibilitychange", () => {
        // Pestaña oculta: se para. No tiene sentido gastar batería en un adorno.
        vivo = !document.hidden;
        if (vivo) requestAnimationFrame(bucle);
      });

      let t0 = performance.now();
      function bucle(ahora: number) {
        if (!vivo) return;
        actual.x += (destino.x - actual.x) * 0.06;
        actual.y += (destino.y - actual.y) * 0.06;
        program.uniforms.uRaton.value.set(actual.x, actual.y);
        program.uniforms.uTiempo.value = (ahora - t0) / 1000;
        medirBandas();
        renderer.render({ scene: malla });
        requestAnimationFrame(bucle);
      }
      requestAnimationFrame(bucle);
      lienzo!.classList.add("listo");
    };

    if ("requestIdleCallback" in window) {
      (window as any).requestIdleCallback(arrancar, { timeout: 2500 });
    } else {
      addEventListener("load", () => setTimeout(arrancar, 400));
    }
  }
</script>
