---
/*
  Capa de mar de TODA LA PÁGINA (2026-08-05, redibujada como mar el 2026-08-10,
  partida en dos el 2026-08-19).

  Un único lienzo WebGL fijo, en fusión "soft-light", que solo pinta donde hay
  campos azules: el guion mide en cada fotograma dónde están en el DOM y fuera
  de ahí deja alfa 0, así que sobre blanco no hace nada. El dibujo del agua no
  está aquí, está en `src/scripts/mar.ts`, compartido.

  ⚠️ ESTA CAPA YA NO SE OCUPA DE LA PORTADA DE LA HOME, y no es un reparto de
  tareas caprichoso. Una capa que va ENCIMA de la página puede ponerse delante
  del azul, pero nunca puede ser parte de él. Los campos azules quietos no
  notan la diferencia; el velo de la portada, que se desvanece para destapar la
  casa, sí: la capa se mezclaba con lo que hubiera debajo en ese momento —la
  plata de la casa— y el mar acababa pintando olas sobre la plata. Eso lo
  resuelve `MarPortada.astro`, que en vez de modular un azul ajeno pinta él el
  azul con el mar dentro. Ver la explicación larga en `mar.ts`.

  Aviso registrado en su día: INV-09 concluyó que el espectáculo tipo WebGL
  resta credibilidad con el público de Atis. Por eso la capa es sutil (opacidad
  baja) y no un fondo protagonista.
*/
---

<canvas id="shader-fondo" aria-hidden="true"></canvas>

<style>
  #shader-fondo {
    position: fixed;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
    mix-blend-mode: soft-light;
  }
  #shader-fondo.listo {
    /*
      Historial: 0.55 -> 0.28 -> 0.13 -> 0.07, bajando cada vez porque el ruido
      se leía como suciedad sobre el azul. El 2026-08-10 sube a 0.30, y no es
      una vuelta atrás: antes la capa cubría TODA la página, así que cualquier
      opacidad que hiciera visible la textura la hacía visible también sobre los
      campos claros, donde solo podía ensuciar. Ahora solo pinta dentro de los
      campos azules, que es donde tiene algo que representar: el mar.

      0.3 emborronaba el logo y el texto. 0.16 se quedaba corto. 0.22 fue el
      punto intermedio. 2026-08-11: sube a 0.34 al pedirse otra vez más
      presencia. Lo que hace que no se lea como suciedad no es la opacidad, es
      que el dibujo son trenes de olas con cresta, no ruido.

      ⚠️ Este número tiene que valer lo mismo que la `fuerza` de MarPortada, o
      el azul de la portada y el de las demás secciones no casarían.
    */
    opacity: 0.34;
  }
  @media (prefers-reduced-motion: reduce) {
    #shader-fondo {
      display: none;
    }
  }
</style>

<script>
  import { crearMar, type Zona } from "../scripts/mar";

  const lienzo = document.getElementById("shader-fondo") as HTMLCanvasElement | null;

  if (lienzo) {
    /*
      Qué se mide, y por qué no es simplemente `.f-azul`:

      · desde que los encabezados y los cierres son TARJETAS (2026-08-11), la
        sección conserva la clase pero su fondo ya es claro; el azul está en el
        bloque de dentro. Si se midiera la sección, el mar saldría por el marco
        claro. Por eso esos tres casos se miden por su hijo.
      · `.hero` (la portada de la home) queda FUERA: su azul lo pinta
        `MarPortada.astro`, que además lo desvanece con él. Si esta capa lo
        tocara, habría dos mares distintos sobre el mismo campo.
    */
    const SELECTOR_AZUL = [
      ".f-azul:not(.hero-field):not(.closer):not(.cta-screen):not(.hero)",
      ".hero-field > .hero-inner",
      ".closer > .closer-inner",
      ".cta-screen > .cta-inner",
    ].join(",");

    /*
      Se mide en cada fotograma, no solo al cargar o al hacer resize: varias
      secciones mueven sus campos con `transform` durante el scroll, y con una
      medida fija el mar se quedaría pintando el sitio de ayer.
    */
    const zonas = (): Zona[] => {
      const lista: Zona[] = [];
      for (const el of document.querySelectorAll<HTMLElement>(SELECTOR_AZUL)) {
        const r = el.getBoundingClientRect();
        if (r.bottom <= 0 || r.top >= innerHeight || r.height <= 0) continue;
        // El radio se lee del propio elemento, no se supone: así los campos a
        // sangre (radio 0) y las tarjetas (28) salen bien sin distinguirlos.
        const radio = parseFloat(getComputedStyle(el).borderTopLeftRadius) || 0;
        lista.push({ top: r.top, bottom: r.bottom, left: r.left, right: r.right, radio });
      }
      return lista;
    };

    crearMar(lienzo, {
      // Esta capa es la ventana entera.
      medida: () => ({ ancho: innerWidth, alto: innerHeight }),
      zonas,
      alArrancar: () => lienzo.classList.add("listo"),
    });
  }
</script>
