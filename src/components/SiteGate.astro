---
/*
  Cortina de acceso (2026-08-04): la web ya está publicada en Vercel para
  poder enseñar el enlace, pero el sitio sigue en obras — así que antes de
  ver cualquier página pide una contraseña compartida ("ATIS10").

  Aviso de seguridad real: esto NO protege nada de verdad. La contraseña
  vive en el HTML/JS que le llega a cualquiera que abra la página, así que
  alguien con conocimientos mínimos puede saltársela. Sirve solo como
  filtro suave para compartir el enlace sin que aparezca por casualidad
  (buscadores, gente que da con la URL sin querer). Si algún día hace
  falta proteger datos de verdad, eso va en el plan de pago de Vercel
  (Deployment Protection) o con autenticación real en servidor.

  Una vez acertada, se recuerda en este navegador (localStorage) y no
  vuelve a preguntar.
*/
---

<div id="site-gate">
  <p class="mark">
    <span class="scr">the</span> <span class="hvy">STUDIO</span>
    <span class="scr">by</span> <span class="hvy">ATIS</span>
  </p>
  <p class="gate-msg">Todavía en obras. Escribe la contraseña para entrar.</p>
  <form id="gateForm" class="gate-form" autocomplete="off">
    <input
      id="gatePass"
      type="password"
      name="password"
      placeholder="Contraseña"
      aria-label="Contraseña de acceso"
      autofocus
    />
    <button type="submit">Entrar</button>
  </form>
  <p id="gateError" class="gate-error" hidden>Contraseña incorrecta, prueba otra vez.</p>
</div>

<style>
  #site-gate {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--azul);
    display: grid;
    place-items: center;
    gap: 22px;
    text-align: center;
    padding: 20px;
    transition: transform 0.7s cubic-bezier(0.76, 0, 0.24, 1);
  }
  #site-gate.done {
    transform: translateY(-101%);
  }
  #site-gate .mark {
    color: var(--plata-clara);
    white-space: nowrap;
    line-height: 1;
    margin: 0;
  }
  #site-gate .scr {
    font-family: var(--script);
    font-size: clamp(1.3rem, 2.6vw, 2.2rem);
  }
  #site-gate .hvy {
    font-family: var(--sans);
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.4rem);
    letter-spacing: -0.03em;
  }
  .gate-msg {
    margin: 0;
    color: rgba(238, 241, 247, 0.78);
    font-size: 0.95rem;
    max-width: 34ch;
  }
  .gate-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .gate-form input {
    font: inherit;
    font-family: var(--sans);
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid rgba(238, 241, 247, 0.3);
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    min-width: 200px;
  }
  .gate-form input::placeholder {
    color: rgba(238, 241, 247, 0.55);
  }
  .gate-form input:focus-visible {
    outline: 2px solid var(--plata-clara);
    outline-offset: 2px;
  }
  .gate-form button {
    font: inherit;
    font-family: var(--sans);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 0.9rem;
    padding: 12px 22px;
    border-radius: 14px;
    border: 0;
    cursor: pointer;
    color: #fff;
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 16px 34px -14px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .gate-form button:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.26);
  }
  .gate-error {
    margin: 0;
    color: #ffb4b4;
    font-size: 0.85rem;
  }
</style>

<script>
  const KEY = "atis-gate-ok";
  const PASS = "ATIS10";
  const gate = document.getElementById("site-gate");

  if (gate) {
    if (localStorage.getItem(KEY) === "1") {
      gate.remove();
    } else {
      /*
        Mientras la cortina está puesta, la página real no debe poder
        moverse por debajo. Sin esto, en móvil, al enfocar el campo de
        contraseña el teclado empuja el documento y se ve la home
        asomando detrás (el input queda "por encima" del scroll bloqueado
        que ya usa Loader.astro para el mismo problema).
      */
      const html = document.documentElement;
      const overflowPrevio = html.style.overflow;
      html.style.overflow = "hidden";

      const form = document.getElementById("gateForm") as HTMLFormElement;
      const input = document.getElementById("gatePass") as HTMLInputElement;
      const error = document.getElementById("gateError") as HTMLParagraphElement;

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        if (input.value.trim().toUpperCase() === PASS) {
          localStorage.setItem(KEY, "1");
          gate.classList.add("done");
          gate.addEventListener(
            "transitionend",
            () => {
              html.style.overflow = overflowPrevio;
              gate.remove();
            },
            { once: true }
          );
        } else {
          error.hidden = false;
          input.value = "";
          input.focus();
        }
      });
    }
  }
</script>
