---
interface Props {
  onLight?: boolean;
  size?: string;
  variant?: "horizontal" | "vertical";
}
const { onLight = false, size = "1.5rem", variant = "horizontal" } = Astro.props;
---

<span class:list={["logo", variant, { "on-light": onLight }]} style={`font-size:${size}`}>
  <span class="scr">the</span><span class="hvy">STUDIO</span><span class="scr">by</span><span class="hvy">ATIS</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.26em;
    line-height: 1;
    justify-content: center;
  }
  .logo .scr {
    font-family: var(--script);
    font-size: 1.5em;
    color: var(--plata-clara);
    transform: translateY(0.06em);
  }
  .logo .hvy {
    font-family: var(--sans);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--ink-on-dark);
    text-transform: uppercase;
  }
  /* on-light: el logo vive sobre una tarjeta clara, no sobre el lienzo azul oscuro */
  .logo.on-light .scr {
    color: var(--plata-oscura);
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
  }
  .logo.on-light .hvy {
    color: var(--ink);
  }

  /* variante vertical: mismos 4 nodos, dispuestos en 2 líneas, alineados a la derecha */
  .logo.vertical {
    display: inline-grid;
    grid-template-columns: auto auto;
    column-gap: 0.22em;
    row-gap: 0;
    align-items: baseline;
    justify-items: end;
  }
  .logo.vertical .hvy {
    font-size: 0.6em;
    line-height: 1.15;
  }
  .logo.vertical .scr {
    font-size: 0.85em;
    transform: none;
  }
</style>
