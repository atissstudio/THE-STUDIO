---
/*
  Menú de la maqueta aprobada, ampliado el 2026-08-03: al desplegarse ocupa
  la pantalla entera, en azul Atis (nunca navy — el navy queda reservado solo
  para el fondo del pie, sin nada encima). Franja fina fija arriba con el
  logo y el acceso rápido a cuenta; al acercar el ratón (o pulsar el botón
  "Menú"), el panel azul crece desde arriba hacia abajo hasta cubrir toda la
  pantalla. Crece poco a poco a propósito (0.85s): si el usuario solo pasa el
  cursor de camino a otra cosa, el paño no llega a completarse y se retira.

  Accesibilidad: el ratón no puede ser la única forma de abrirlo. El botón
  "Menú" es un <button> real, así que también abre con teclado y cierra con
  Escape.
*/
import Logo from "./Logo.astro";

const links = [
  { href: "/sobre-atis", label: "Sobre Atis" },
  { href: "/como-trabajamos", label: "Cómo trabajamos" },
  { href: "/servicios", label: "Servicios" },
  { href: "/casos", label: "Casos" },
  { href: "/contacto", label: "Contacto" },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + "/");
---

<header id="menubar">
  <button
    class="toggle"
    type="button"
    aria-expanded="false"
    aria-controls="menupanel"
    aria-label="Abrir el menú de navegación"
  >
    Menú
  </button>
  <a class="mark" href="/" aria-label="The Studio, by Atis — inicio">
    <span class="mark-h"><Logo size="0.92rem" onLight /></span>
    <span class="mark-v"><Logo variant="vertical" size="0.92rem" onLight /></span>
  </a>
  <a class="account" href="/portal/login" aria-label="Acceder a tu cuenta">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="8" r="4"></circle>
      <path d="M4 20c1.6-4 4.6-6 8-6s6.4 2 8 6"></path>
    </svg>
  </a>
</header>

<div id="menupanel" hidden>
  <button class="cerrar" id="menuCerrar" type="button" aria-label="Cerrar menú">✕</button>

  <nav class="menu-links" aria-label="Navegación principal">
    {
      links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? "page" : undefined}>
          <span>{l.label}</span>
        </a>
      ))
    }
  </nav>

  {/*
    El muñeco: acceso a cuenta con algo de gracia, en el hueco que deja la
    lista de enlaces a la derecha. Baila solo (animación continua) y además
    los ojos siguen al cursor mientras el menú está abierto (ver script).
  */}
  <a class="mascota" href="/portal/login" aria-label="Acceder a tu cuenta de cliente">
    <svg class="mascota-svg" viewBox="0 0 160 220" aria-hidden="true">
      <g class="pierna pierna-izq" transform-origin="64 176">
        <line x1="64" y1="176" x2="48" y2="214"></line>
      </g>
      <g class="pierna pierna-der" transform-origin="96 176">
        <line x1="96" y1="176" x2="112" y2="214"></line>
      </g>
      <ellipse class="cuerpo" cx="80" cy="140" rx="33" ry="44"></ellipse>
      <g class="brazo brazo-izq" transform-origin="52 112">
        <line x1="52" y1="112" x2="26" y2="148"></line>
      </g>
      <g class="brazo brazo-der" transform-origin="108 112">
        <line x1="108" y1="112" x2="134" y2="148"></line>
      </g>
      <circle class="cabeza" cx="80" cy="60" r="46"></circle>
      <g class="ojos">
        <circle class="ojo" cx="63" cy="56" r="7"></circle>
        <circle class="ojo" cx="97" cy="56" r="7"></circle>
      </g>
      <path class="boca" d="M60 78 Q80 92 100 78"></path>
    </svg>
    <span class="mascota-label">Iniciar sesión</span>
  </a>

</div>

<style>
  /* Franja: fondo blanco sólido, texto y logo en azul */
  #menubar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--menu-h);
    z-index: 80;
    background: #fff;
    color: var(--azul);
    border: 0;
    border-bottom: 1px solid rgba(17, 21, 32, 0.1);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    font-family: var(--sans);
    width: 100%;
  }
  #menubar .toggle {
    grid-column: 2/5;
    justify-self: start;
    font: inherit;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--azul);
    background: none;
    border: 0;
    padding: 0;
    margin-left: 20px;
    cursor: pointer;
  }
  #menubar .mark {
    grid-column: 6/8;
    display: grid;
    place-items: center;
    line-height: 1;
    text-decoration: none;
  }
  /* El logo hereda ink/plata-oscura de onLight; se fuerza a azul aquí */
  #menubar .mark :global(.hvy),
  #menubar .mark :global(.scr) {
    color: var(--azul);
    text-shadow: none;
  }
  /* Escritorio: logo horizontal. La versión vertical solo se usa en móvil (ver media query). */
  #menubar .mark-v {
    display: none;
  }
  #menubar .account {
    grid-column: 11/12;
    justify-self: end;
    margin-right: 20px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
  }
  #menubar .account svg {
    width: 22px;
    height: 22px;
  }
  #menubar .account path,
  #menubar .account circle {
    stroke: var(--azul);
    stroke-width: 1.7;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  #menubar .toggle:focus-visible,
  #menubar .account:focus-visible {
    outline: 2px solid var(--azul);
    outline-offset: 2px;
  }

  /*
    Panel a pantalla completa, azul Atis (nunca navy). Se revela con clip-path
    de arriba abajo en vez de un simple deslizamiento: así "crece" en vez de
    aparecer de golpe, y una pasada rápida del cursor por la franja no llega
    a completarlo.
  */
  #menupanel {
    position: fixed;
    top: var(--menu-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 79;
    background: var(--azul);
    color: var(--plata-clara);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.85s cubic-bezier(0.16, 0.7, 0.2, 1);
  }
  #menupanel[hidden] {
    display: grid; /* se controla con clip-path, no con hidden */
  }
  #menupanel.open {
    clip-path: inset(0 0 0% 0);
  }

  /* Retícula: los títulos separados por líneas, como un índice editorial */
  .menu-links {
    grid-column: 2/8;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-top: 1px solid rgba(238, 241, 247, 0.25);
  }
  /*
    La raya divisoria va en el enlace, que ocupa el ancho completo, para que
    todas midan lo mismo. Antes el enlace era `width: fit-content` y cada raya
    terminaba donde acababa su palabra, así que se veían escalonadas y
    desiguales (corregido 2026-08-05). El subrayado de hover sigue ciñéndose
    solo al texto: vive en el <span> de dentro, no en el enlace.
  */
  .menu-links a {
    display: block;
    padding: clamp(14px, 2.4vw, 26px) 4px;
    border-bottom: 1px solid rgba(238, 241, 247, 0.25);
    color: var(--plata-clara);
    text-decoration: none;
    font-family: var(--sans);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: clamp(1.8rem, 5vw, 4rem);
    line-height: 1.05;
  }
  .menu-links a span {
    display: inline-block;
    max-width: 100%;
    background-image: linear-gradient(90deg, #fff, #c9cfdb);
    background-size: 0% 3px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.35s ease;
  }
  .menu-links a:hover span,
  .menu-links a:focus-visible span {
    background-size: 100% 3px;
  }
  .menu-links a[aria-current="page"] {
    color: #fff;
  }
  .menu-links a[aria-current="page"] span {
    background-size: 100% 3px;
  }

  /* El muñeco ocupa el hueco de la derecha, línea divisoria con la retícula */
  .mascota {
    grid-column: 9/12;
    align-self: center;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    padding-left: clamp(20px, 3vw, 48px);
    border-left: 1px solid rgba(238, 241, 247, 0.25);
  }
  .mascota-svg {
    width: clamp(84px, 8vw, 140px);
    height: auto;
    transform-origin: 50% 100%;
    animation: bailar 2.4s ease-in-out infinite;
  }
  @keyframes bailar {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-12px) rotate(4deg);
    }
  }
  .cuerpo {
    fill: rgba(238, 241, 247, 0.3);
  }
  .cabeza {
    fill: var(--plata-clara);
  }

  /*
    Brazos y piernas: cada uno es un <g> con su propio transform-origin en la
    articulación (hombro o cadera), balanceándose de forma independiente para
    que se note el baile, no solo un rebote entero del cuerpo.
  */
  .brazo line,
  .pierna line {
    stroke: rgba(238, 241, 247, 0.32);
    stroke-width: 13;
    stroke-linecap: round;
  }
  .brazo-izq {
    animation: brazoIzq 1.1s ease-in-out infinite;
  }
  .brazo-der {
    animation: brazoDer 1.1s ease-in-out infinite;
  }
  .pierna-izq {
    animation: piernaIzq 1.1s ease-in-out infinite;
  }
  .pierna-der {
    animation: piernaDer 1.1s ease-in-out infinite;
  }
  @keyframes brazoIzq {
    0%,
    100% {
      transform: rotate(-20deg);
    }
    50% {
      transform: rotate(16deg);
    }
  }
  @keyframes brazoDer {
    0%,
    100% {
      transform: rotate(20deg);
    }
    50% {
      transform: rotate(-16deg);
    }
  }
  @keyframes piernaIzq {
    0%,
    100% {
      transform: rotate(14deg);
    }
    50% {
      transform: rotate(-12deg);
    }
  }
  @keyframes piernaDer {
    0%,
    100% {
      transform: rotate(-14deg);
    }
    50% {
      transform: rotate(12deg);
    }
  }
  .ojos {
    transition: transform 0.15s ease-out;
  }
  .ojo {
    fill: var(--azul);
  }
  .boca {
    fill: none;
    stroke: var(--azul);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .mascota-label {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--plata-clara);
  }
  .mascota:hover .mascota-svg,
  .mascota:focus-visible .mascota-svg {
    animation-play-state: paused;
    transform: translateY(-6px) rotate(0deg);
  }
  .mascota:hover .brazo,
  .mascota:hover .pierna,
  .mascota:focus-visible .brazo,
  .mascota:focus-visible .pierna {
    animation-play-state: paused;
  }

  .cerrar {
    position: absolute;
    top: 22px;
    right: 24px;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(16px) saturate(1.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: 0 12px 26px -16px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.28);
    color: var(--plata-clara);
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease, background 0.2s ease;
  }
  .cerrar:hover,
  .cerrar:focus-visible {
    transform: rotate(90deg);
    background: rgba(255, 255, 255, 0.18);
    outline: 2px solid var(--plata-clara);
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    /*
      Móvil: la franja deja de ser fija arriba y pasa a ser una píldora de
      cristal claro flotando abajo, cerca del pulgar. Nunca afecta a
      escritorio (todo dentro de esta media query).
    */
    #menubar {
      top: auto;
      bottom: 16px;
      left: 16px;
      right: 16px;
      width: auto;
      height: 56px;
      border-radius: 18px;
      border-bottom: 0;
      /*
        Sin backdrop-filter en móvil (2026-08-04): un desenfoque de cristal
        sobre un elemento fijo obliga al teléfono a recalcularlo en cada
        fotograma de scroll — de las cosas más caras que se le puede pedir a
        una GPU de móvil, y hacía que el scroll de toda la web se notara
        pesado. Fondo más sólido en su lugar: se pierde el cristal, gana la
        fluidez.
      */
      background: rgba(255, 255, 255, 0.92);
      box-shadow: 0 16px 34px -14px rgba(51, 75, 164, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.85);
    }
    #menubar .mark {
      grid-column: 5/9;
    }
    /* En móvil el logo va en vertical (dos líneas), cabe mejor en la píldora */
    #menubar .mark-h {
      display: none;
    }
    #menubar .mark-v {
      display: grid;
      place-items: center;
    }

    /*
      El panel ahora crece desde abajo (donde vive la barra) hacia arriba,
      en vez de deslizarse desde arriba, y a pantalla completa: ya no hace
      falta reservar el hueco superior de la franja, porque la franja ya
      no vive ahí.
    */
    #menupanel {
      top: 0;
      clip-path: inset(100% 0 0 0);
      grid-template-columns: 1fr;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 0 20px 90px;
    }
    #menupanel.open {
      clip-path: inset(0 0 0 0);
    }
    .menu-links {
      grid-column: unset;
      border-top: 1px solid rgba(238, 241, 247, 0.25);
    }
    .menu-links a {
      font-size: clamp(1.6rem, 9vw, 2.4rem);
    }
    .mascota {
      grid-column: unset;
      flex-direction: row;
      justify-content: flex-start;
      border-left: 0;
      border-top: 1px solid rgba(238, 241, 247, 0.25);
      padding: 22px 0 0;
      margin-top: 22px;
    }
    .mascota-svg {
      width: 64px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #menupanel {
      transition: none;
    }
    .mascota-svg,
    .brazo,
    .pierna {
      animation: none;
    }
  }
</style>

<script>
  const bar = document.getElementById("menubar");
  const toggle = document.getElementById("menubar")?.querySelector<HTMLButtonElement>(".toggle");
  const panel = document.getElementById("menupanel");
  const cerrar = document.getElementById("menuCerrar");
  const mascotaSvg = document.querySelector<SVGElement>(".mascota-svg");
  const ojos = document.querySelector<SVGGElement>(".ojos");

  if (bar && toggle && panel) {
    panel.removeAttribute("hidden");

    let mirarActivo = false;

    // Los ojos del muñeco siguen al cursor, con un recorrido corto y clavado.
    const mirar = (e: MouseEvent) => {
      if (mascotaSvg && ojos) {
        const r = mascotaSvg.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height * 0.28; // altura aproximada de la cabeza
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const dist = Math.hypot(dx, dy) || 1;
        const max = 5;
        const ox = (dx / dist) * Math.min(max, dist / 30);
        const oy = (dy / dist) * Math.min(max, dist / 30);
        ojos.style.transform = `translate(${ox}px, ${oy}px)`;
      }

      // Si el ratón baja cerca del borde de la pantalla, se cierra solo.
      if (innerHeight - e.clientY < 60) setOpen(false);
    };

    // Cerrar con la rueda o el gesto de deslizar hacia abajo, mientras está abierto.
    const cerrarAlDeslizar = (e: WheelEvent) => {
      if (e.deltaY > 0) setOpen(false);
    };
    let tocadoY = 0;
    const tocarInicio = (e: TouchEvent) => {
      tocadoY = e.touches[0]?.clientY ?? 0;
    };
    const esMovil = matchMedia("(max-width: 900px)");
    const tocarMover = (e: TouchEvent) => {
      const y = e.touches[0]?.clientY ?? tocadoY;
      // En móvil el panel crece desde abajo (la barra vive ahí), así que
      // el gesto de cerrar se invierte: el dedo baja hacia la franja.
      if (esMovil.matches) {
        if (y - tocadoY > 12) setOpen(false);
      } else if (tocadoY - y > 12) {
        setOpen(false); // escritorio: el dedo sube en pantalla = gesto de bajar
      }
    };

    const setOpen = (on: boolean) => {
      panel.classList.toggle("open", on);
      toggle.setAttribute("aria-expanded", String(on));
      toggle.setAttribute("aria-label", on ? "Cerrar el menú de navegación" : "Abrir el menú de navegación");
      toggle.textContent = on ? "Cerrar" : "Menú";

      if (on && !mirarActivo) {
        addEventListener("mousemove", mirar, { passive: true });
        addEventListener("wheel", cerrarAlDeslizar, { passive: true });
        addEventListener("touchstart", tocarInicio, { passive: true });
        addEventListener("touchmove", tocarMover, { passive: true });
        mirarActivo = true;
      } else if (!on && mirarActivo) {
        removeEventListener("mousemove", mirar);
        removeEventListener("wheel", cerrarAlDeslizar);
        removeEventListener("touchstart", tocarInicio);
        removeEventListener("touchmove", tocarMover);
        mirarActivo = false;
        ojos?.style.removeProperty("transform");
      }
    };

    const isOpen = () => panel.classList.contains("open");

    // Ratón: se abre al acercarse a la franja, se cierra al salir del panel.
    bar.addEventListener("mouseenter", () => setOpen(true));
    panel.addEventListener("mouseleave", () => setOpen(false));

    // Teclado y toque: el botón "Menú"/"Cerrar" y la equis abren y cierran.
    toggle.addEventListener("click", () => setOpen(!isOpen()));
    cerrar?.addEventListener("click", () => {
      setOpen(false);
      toggle.focus();
    });
    addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
