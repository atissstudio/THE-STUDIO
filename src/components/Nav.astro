---
import Logo from "./Logo.astro";

const links = [
  { href: "/sobre-atis", label: "Sobre Atis" },
  { href: "/como-trabajamos", label: "Cómo trabajamos" },
  { href: "/servicios", label: "Servicios" },
  { href: "/casos", label: "Casos" },
  { href: "/contacto", label: "Contacto" },
];
---

<header class="nav">
  <a href="/" aria-label="The Studio, by Atis — inicio">
    <Logo />
  </a>
  <div class="rule"></div>
  <nav aria-label="Navegación principal">
    <ul>
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    padding: 24px 0 6px;
    text-align: center;
  }
  .rule {
    width: 52px;
    height: 2px;
    background: var(--azul);
    margin: 16px auto 20px;
    border-radius: 2px;
    opacity: 0.5;
  }
  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover {
    color: var(--azul);
  }
</style>
