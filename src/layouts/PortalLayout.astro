---
import "../styles/tokens.css";
import SEO from "../components/SEO.astro";
import Logo from "../components/Logo.astro";

interface Props {
  title: string;
  path: string;
  userName?: string;
}
const { title, path, userName } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO
      title={title}
      description="Portal de cliente de The Studio, by Atis."
      path={path}
      noindex
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet" />
  </head>
  <body>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="plataLiquida" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#f4f5f7"></stop>
          <stop offset="28%" stop-color="#aab0bb"></stop>
          <stop offset="52%" stop-color="#e8eaed"></stop>
          <stop offset="76%" stop-color="#9aa0ab"></stop>
          <stop offset="100%" stop-color="#eef0f2"></stop>
        </linearGradient>
      </defs>
    </svg>

    <header class="portal-header">
      <a href="/" aria-label="The Studio, by Atis — inicio" class="brand">
        <Logo size="1.3rem" />
      </a>
      <span class="demo-tag">Portal de cliente</span>
      <div class="spacer"></div>
      {
        userName && (
          <div class="account">
            <span class="who">{userName}</span>
            <form method="POST" action="/portal/logout">
              <button type="submit" class="logout">Salir</button>
            </form>
          </div>
        )
      }
    </header>

    <main class="portal-main">
      <slot />
    </main>

    <footer class="portal-footer">
      <small>Portal privado — este contenido es solo tuyo.</small>
    </footer>

    <style>
      /*
        El portal conserva el lienzo oscuro. En v5 el sitio público pasó a campos
        de color sobre body claro, y sin esto el portal (pensado en v4, con textos
        en plata) quedaba claro sobre claro. Es una zona cerrada, no una página
        pública, así que no le aplica el ritmo de campos de color.
      */
      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--navy);
        color: var(--ink-on-dark);
      }
      .portal-header {
        display: flex;
        align-items: center;
        gap: 16px;
        max-width: 1000px;
        margin: 0 auto;
        width: 100%;
        padding: 22px 24px 18px;
      }
      .brand {
        line-height: 1;
      }
      .demo-tag {
        font-family: var(--sans);
        font-size: 0.64rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--plata-clara);
        background: rgba(111, 134, 224, 0.2);
        border-radius: 20px;
        padding: 5px 12px;
      }
      .spacer {
        flex: 1;
      }
      .account {
        display: flex;
        align-items: center;
        gap: 12px;
        font-family: var(--sans);
      }
      .who {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--muted-on-dark);
      }
      /* Mismo cristal que el resto de botones de la web */
      .logout {
        font-family: var(--sans);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--plata-clara);
        background: rgba(111, 134, 224, 0.18);
        backdrop-filter: blur(14px) saturate(1.4);
        -webkit-backdrop-filter: blur(14px) saturate(1.4);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 999px;
        padding: 8px 16px;
        cursor: pointer;
        box-shadow: 0 10px 22px -14px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.18);
        transition: transform 0.2s ease, background 0.2s ease;
      }
      .logout:hover {
        background: rgba(111, 134, 224, 0.3);
        transform: translateY(-1px);
      }
      .portal-main {
        flex: 1;
        max-width: 1000px;
        margin: 0 auto;
        width: 100%;
        padding: 0 24px 64px;
      }
      .portal-footer {
        text-align: center;
        padding: 18px 24px 32px;
        border-top: 1px solid rgba(255, 255, 255, 0.15);
        max-width: 1000px;
        margin: 0 auto;
        width: 100%;
      }
      .portal-footer small {
        font-family: var(--sans);
        color: var(--muted-on-dark);
        font-size: 0.74rem;
      }
    </style>
  </body>
</html>
